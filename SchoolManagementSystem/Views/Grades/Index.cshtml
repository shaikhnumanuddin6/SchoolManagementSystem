@model SchoolManagementSystem.Application.ViewModels.Grades.GradeListViewModel

@{
    ViewData["Title"] = "Grade Management";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Grade Management</h2>
            <p class="text-muted mb-0">
                Manage student marks, assessment results and performance.
            </p>
        </div>

        <a asp-controller="Grades"
           asp-action="Create"
           class="btn btn-primary">
            <span class="me-1">+</span> Add Grade
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- SUMMARY CARDS -->

    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">
                        Total Grade Records
                    </div>
                    <h3 class="fw-bold mb-0">
                        @Model.TotalGrades
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">
                        Average Percentage
                    </div>
                    <h3 class="fw-bold mb-0">
                        @Model.AveragePercentage.ToString("0.0")%
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">
                        Current Results
                    </div>
                    <h3 class="fw-bold mb-0">
                        @Model.Grades.Count
                    </h3>
                    <small class="text-muted">
                        Matching the selected filters
                    </small>
                </div>
            </div>
        </div>

    </div>

    <!-- SEARCH AND FILTERS -->

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">Search and Filters</h5>
        </div>

        <div class="card-body">
            <form asp-controller="Grades"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-12 col-lg-3">
                        <label asp-for="SearchTerm"
                               class="form-label">
                            Search
                        </label>
                        <input asp-for="SearchTerm"
                               class="form-control"
                               placeholder="Student, admission no. or assessment" />
                    </div>

                    <div class="col-12 col-md-4 col-lg-3">
                        <label asp-for="ClassId"
                               class="form-label">
                            Class
                        </label>
                        <select asp-for="ClassId"
                                asp-items="Model.Classes"
                                class="form-select">
                            <option value="">All Classes</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-4 col-lg-3">
                        <label asp-for="StudentId"
                               class="form-label">
                            Student
                        </label>
                        <select asp-for="StudentId"
                                asp-items="Model.Students"
                                class="form-select">
                            <option value="">All Students</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-4 col-lg-3">
                        <label asp-for="SubjectId"
                               class="form-label">
                            Subject
                        </label>
                        <select asp-for="SubjectId"
                                asp-items="Model.Subjects"
                                class="form-select">
                            <option value="">All Subjects</option>
                        </select>
                    </div>

                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">
                        Apply Filters
                    </button>

                    <a asp-controller="Grades"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear Filters
                    </a>
                </div>

            </form>
        </div>
    </div>

    <!-- GRADES TABLE -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3
                    d-flex justify-content-between
                    align-items-center">
            <h5 class="fw-semibold mb-0">Grade Records</h5>

            <span class="badge text-bg-secondary">
                @Model.TotalGrades records
            </span>
        </div>

        <div class="card-body p-0">

            @if (Model.Grades.Count == 0)
            {
                <div class="text-center py-5 px-3">
                    <h5 class="text-muted">No grades found</h5>
                    <p class="text-muted mb-3">
                        There are no grade records matching your filters.
                    </p>

                    <a asp-controller="Grades"
                       asp-action="Create"
                       class="btn btn-primary">
                        Add First Grade
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Class</th>
                                <th>Subject</th>
                                <th>Assessment</th>
                                <th>Marks</th>
                                <th>Percentage</th>
                                <th>Grade</th>
                                <th>Exam Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var grade in Model.Grades)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @grade.StudentName
                                        </div>
                                        <small class="text-muted">
                                            @grade.AdmissionNumber
                                        </small>
                                    </td>

                                    <td>
                                        @(grade.ClassName ?? "Unassigned")
                                    </td>

                                    <td>
                                        @grade.SubjectName
                                    </td>

                                    <td>
                                        @grade.AssessmentName
                                    </td>

                                    <td class="text-nowrap">
                                        @grade.MarksObtained.ToString("0.##")
                                        /
                                        @grade.MaxMarks.ToString("0.##")
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @grade.Percentage.ToString("0.0")%
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(
                                       grade.GradeLetter))
                                        {
                                            <span class="badge text-bg-primary">
                                                @grade.GradeLetter
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td class="text-nowrap">
                                        @grade.ExamDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-end text-nowrap">
                                        <a asp-controller="Grades"
                                           asp-action="Details"
                                           asp-route-id="@grade.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>

                                        <a asp-controller="Grades"
                                           asp-action="Edit"
                                           asp-route-id="@grade.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>