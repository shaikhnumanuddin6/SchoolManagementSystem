@model SchoolManagementSystem.Application.ViewModels.Teachers.TeacherDashboardViewModel

@{
    ViewData["Title"] = "Teacher Dashboard";
}

<div class="container-fluid py-4">

    <!-- =======================================================
         HEADER
         ======================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Welcome, @Model.TeacherName 👋
            </h1>

            <p class="text-muted mb-0">
                Here's an overview of your classes and students.
            </p>
        </div>

        <div class="text-muted">
            <i class="bi bi-calendar3 me-1"></i>
            @DateTime.Now.ToString("dddd, dd MMMM yyyy")
        </div>

    </div>


    <!-- =======================================================
         SUMMARY CARDS
         ======================================================= -->

    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card stat-card h-100">

                <div class="stat-card-content">

                    <div>

                        <span class="stat-label">
                            My Classes
                        </span>

                        <h2>
                            @Model.AssignedClasses
                        </h2>

                        <span class="stat-description">
                            Assigned active classes
                        </span>

                    </div>

                    <div class="stat-icon classes-icon">
                        <i class="bi bi-building"></i>
                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card stat-card h-100">

                <div class="stat-card-content">

                    <div>

                        <span class="stat-label">
                            My Students
                        </span>

                        <h2>
                            @Model.TotalStudents
                        </h2>

                        <span class="stat-description">
                            Across all assigned classes
                        </span>

                    </div>

                    <div class="stat-icon students-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card stat-card h-100">

                <div class="stat-card-content">

                    <div>

                        <span class="stat-label">
                            Today's Attendance
                        </span>

                        <h2>
                            @Model.AttendancePercentage.ToString("0.0")%
                        </h2>

                        <span class="stat-description">
                            @Model.AttendanceRecordsToday records
                        </span>

                    </div>

                    <div class="stat-icon attendance-icon">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card stat-card h-100">

                <div class="stat-card-content">

                    <div>

                        <span class="stat-label">
                            Average Grade
                        </span>

                        <h2>
                            @Model.AverageGradePercentage.ToString("0.0")%
                        </h2>

                        <span class="stat-description">
                            @Model.TotalGrades grades recorded
                        </span>

                    </div>

                    <div class="stat-icon teachers-icon">
                        <i class="bi bi-award-fill"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =======================================================
         TODAY'S ATTENDANCE
         ======================================================= -->

    <div class="row g-4 mb-4">

        <div class="col-lg-4">

            <div class="dashboard-card h-100">

                <div class="card-header-custom">

                    <div>
                        <h5 class="mb-1">
                            Present
                        </h5>

                        <p class="text-muted mb-0">
                            Today's attendance
                        </p>
                    </div>

                    <i class="bi bi-check-circle text-success fs-3"></i>

                </div>

                <div class="display-5 fw-bold text-success mt-4">
                    @Model.PresentToday
                </div>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="dashboard-card h-100">

                <div class="card-header-custom">

                    <div>
                        <h5 class="mb-1">
                            Absent
                        </h5>

                        <p class="text-muted mb-0">
                            Today's attendance
                        </p>
                    </div>

                    <i class="bi bi-x-circle text-danger fs-3"></i>

                </div>

                <div class="display-5 fw-bold text-danger mt-4">
                    @Model.AbsentToday
                </div>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="dashboard-card h-100">

                <div class="card-header-custom">

                    <div>
                        <h5 class="mb-1">
                            Late
                        </h5>

                        <p class="text-muted mb-0">
                            Today's attendance
                        </p>
                    </div>

                    <i class="bi bi-clock text-warning fs-3"></i>

                </div>

                <div class="display-5 fw-bold text-warning mt-4">
                    @Model.LateToday
                </div>

            </div>

        </div>

    </div>


    <!-- =======================================================
         MY CLASSES
         ======================================================= -->

    <div class="dashboard-card mb-4">

        <div class="card-header-custom">

            <div>
                <h5 class="mb-1">
                    My Classes
                </h5>

                <p class="text-muted mb-0">
                    Attendance overview for your assigned classes
                </p>
            </div>

            <span class="badge bg-primary">
                @Model.Classes.Count classes
            </span>

        </div>

        <div class="table-responsive mt-3">

            @if (Model.Classes.Any())
            {
                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>Class</th>

                            <th>Academic Year</th>

                            <th>Students</th>

                            <th>Present</th>

                            <th>Absent</th>

                            <th>Late</th>

                            <th>Attendance</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Classes)
                        {
                            <tr>

                                <td>

                                    <div class="fw-semibold">
                                        @item.ClassName
                                        - @item.Section
                                    </div>

                                </td>

                                <td>
                                    @item.AcademicYear
                                </td>

                                <td>

                                    <span class="badge bg-info text-dark">
                                        @item.StudentCount
                                    </span>

                                </td>

                                <td>
                                    <span class="text-success fw-semibold">
                                        @item.PresentCount
                                    </span>
                                </td>

                                <td>
                                    <span class="text-danger fw-semibold">
                                        @item.AbsentCount
                                    </span>
                                </td>

                                <td>
                                    <span class="text-warning fw-semibold">
                                        @item.LateCount
                                    </span>
                                </td>

                                <td style="min-width:180px;">

                                    <div class="d-flex justify-content-between mb-1">

                                        <small>
                                            @item.AttendancePercentage.ToString("0.0")%
                                        </small>

                                    </div>

                                    <div class="progress"
                                         style="height:8px;">

                                        <div class="progress-bar"
                                             role="progressbar"
                                             style="width:@item.AttendancePercentage%;">
                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="text-center py-5 text-muted">

                    <i class="bi bi-building fs-1"></i>

                    <h6 class="mt-3">
                        No classes assigned
                    </h6>

                    <p class="mb-0">
                        Your assigned classes will appear here.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- =======================================================
         PERFORMANCE
         ======================================================= -->

    <div class="row g-4 mb-4">

        <div class="col-xl-7">

            <div class="dashboard-card h-100">

                <div class="card-header-custom">

                    <div>
                        <h5 class="mb-1">
                            Subject Performance
                        </h5>

                        <p class="text-muted mb-0">
                            Average performance across your classes
                        </p>
                    </div>

                    <i class="bi bi-bar-chart-line fs-4"></i>

                </div>

                <div class="mt-4">

                    @if (Model.PerformanceData.Any())
                    {
                        foreach (var item in Model.PerformanceData)
                        {
                            <div class="mb-4">

                                <div class="d-flex justify-content-between mb-1">

                                    <span class="fw-semibold">
                                        @item.SubjectName
                                    </span>

                                    <span>
                                        @item.Percentage.ToString("0.0")%
                                    </span>

                                </div>

                                <div class="progress"
                                     style="height:10px;">

                                    <div class="progress-bar"
                                         role="progressbar"
                                         style="width:@item.Percentage%;">
                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">

                            <i class="bi bi-bar-chart fs-2"></i>

                            <p class="mt-2 mb-0">
                                No grade data available yet.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <div class="col-xl-5">

            <div class="dashboard-card h-100">

                <div class="card-header-custom">

                    <div>
                        <h5 class="mb-1">
                            Recent Grades
                        </h5>

                        <p class="text-muted mb-0">
                            Latest marks recorded
                        </p>
                    </div>

                </div>

                <div class="table-responsive mt-3">

                    @if (Model.RecentGrades.Any())
                    {
                        <table class="table table-sm align-middle">

                            <thead class="table-light">

                                <tr>

                                    <th>Student</th>

                                    <th>Subject</th>

                                    <th>Score</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var grade in Model.RecentGrades)
                                {
                                    <tr>

                                        <td>
                                            <div class="fw-semibold">
                                                @grade.StudentName
                                            </div>

                                            <div class="small text-muted">
                                                @grade.ClassName -
                                                @grade.Section
                                            </div>
                                        </td>

                                        <td>
                                            @grade.SubjectName
                                        </td>

                                        <td>
                                            <span class="fw-semibold">
                                                @grade.MarksObtained /
                                                @grade.MaxMarks
                                            </span>

                                            <div class="small text-muted">
                                                @grade.Percentage.ToString("0.0")%
                                            </div>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">

                            <i class="bi bi-award fs-2"></i>

                            <p class="mt-2 mb-0">
                                No grades recorded yet.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =======================================================
         RECENT ATTENDANCE
         ======================================================= -->

    <div class="dashboard-card">

        <div class="card-header-custom">

            <div>
                <h5 class="mb-1">
                    Recent Attendance
                </h5>

                <p class="text-muted mb-0">
                    Latest attendance records from your classes
                </p>
            </div>

        </div>

        <div class="table-responsive mt-3">

            @if (Model.RecentAttendance.Any())
            {
                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>Student</th>

                            <th>Class</th>

                            <th>Status</th>

                            <th>Date</th>

                            <th>Remarks</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.RecentAttendance)
                        {
                            <tr>

                                <td>
                                    @item.StudentName
                                </td>

                                <td>
                                    @item.ClassName -
                                    @item.Section
                                </td>

                                <td>

                                    @if (item.Status == "Present")
                                    {
                                        <span class="badge bg-success">
                                            Present
                                        </span>
                                    }
                                    else if (item.Status == "Absent")
                                    {
                                        <span class="badge bg-danger">
                                            Absent
                                        </span>
                                    }
                                    else if (item.Status == "Late")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Late
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }

                                </td>

                                <td>
                                    @item.Date.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Remarks)
                                        ? "-"
                                        : item.Remarks)
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="text-center py-5 text-muted">

                    <i class="bi bi-calendar-x fs-1"></i>

                    <h6 class="mt-3">
                        No attendance records
                    </h6>

                    <p class="mb-0">
                        Attendance from your classes will appear here.
                    </p>

                </div>
            }

        </div>

    </div>

</div>