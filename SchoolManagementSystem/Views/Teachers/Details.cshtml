@model SchoolManagementSystem.Application.ViewModels.Teachers.TeacherDetailsViewModel

@{
    ViewData["Title"] = "Teacher Details";

    var emailText =
        string.IsNullOrWhiteSpace(Model.Email)
            ? "Not provided"
            : Model.Email;

    var qualificationText =
        string.IsNullOrWhiteSpace(Model.Qualification)
            ? "Not provided"
            : Model.Qualification;

    var departmentText =
        string.IsNullOrWhiteSpace(Model.SpecializationDepartment)
            ? "Not provided"
            : Model.SpecializationDepartment;

    var phoneText =
        string.IsNullOrWhiteSpace(Model.Phone)
            ? "Not provided"
            : Model.Phone;

    var hireDateText =
        Model.HireDate.HasValue
            ? Model.HireDate.Value.ToString("dd MMM yyyy")
            : "Not provided";

    var statusText =
        Model.IsActive
            ? "Active"
            : "Archived";

    var statusClass =
        Model.IsActive
            ? "bg-success"
            : "bg-secondary";
}

<div class="container-fluid py-4">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->

    <div class="d-flex flex-column flex-lg-row
                justify-content-between
                align-items-lg-center
                gap-3 mb-4">

        <div>

            <div class="text-muted small mb-1">
                Administration
            </div>

            <h1 class="h3 fw-bold mb-1">
                Teacher Details
            </h1>

            <p class="text-muted mb-0">
                View teacher profile and assigned classes.
            </p>

        </div>


        <div class="d-flex gap-2">

            <a asp-controller="Teachers"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-2"></i>
                Back to Teachers

            </a>


            <a asp-controller="Teachers"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil-square me-2"></i>
                Edit Teacher

            </a>

        </div>

    </div>


    <!-- ============================================================
         TEACHER PROFILE
         ============================================================ -->

    <div class="row g-4">

        <div class="col-12 col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle
                                    bg-primary-subtle
                                    text-primary
                                    fw-bold
                                    d-flex
                                    align-items-center
                                    justify-content-center
                                    me-3"
                             style="width:60px;height:60px;">

                            @if (!string.IsNullOrWhiteSpace(Model.FullName))
                            {
                                @Model.FullName.Substring(
                                         0,
                                         1
                                         ).ToUpperInvariant()
                            }
                            else
                            {
                                <span>TC</span>
                            }

                        </div>


                        <div>

                            <h4 class="mb-1 fw-bold">
                                @Model.FullName
                            </h4>

                            <div class="text-muted">
                                Employee No:
                                <strong>
                                    @Model.EmployeeNumber
                                </strong>
                            </div>

                        </div>

                    </div>

                </div>


                <div class="card-body">

                    <div class="row g-4">

                        <!-- EMAIL -->

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Email
                            </label>

                            <div class="fw-semibold">
                                @emailText
                            </div>

                        </div>


                        <!-- EMPLOYEE NUMBER -->

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Employee Number
                            </label>

                            <div class="fw-semibold">
                                @Model.EmployeeNumber
                            </div>

                        </div>


                        <!-- QUALIFICATION -->

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Qualification
                            </label>

                            <div class="fw-semibold">
                                @qualificationText
                            </div>

                        </div>


                        <!-- DEPARTMENT -->

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Specialization / Department
                            </label>

                            <div class="fw-semibold">
                                @departmentText
                            </div>

                        </div>


                        <!-- PHONE -->

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Phone
                            </label>

                            <div class="fw-semibold">
                                @phoneText
                            </div>

                        </div>


                        <!-- HIRE DATE -->

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Hire Date
                            </label>

                            <div class="fw-semibold">
                                @hireDateText
                            </div>

                        </div>


                        <!-- STATUS -->

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Status
                            </label>

                            <div>

                                <span class="badge @statusClass">
                                    @statusText
                                </span>

                            </div>

                        </div>


                        <!-- CLASS COUNT -->

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Assigned Classes
                            </label>

                            <div class="fw-semibold">
                                @Model.ClassCount
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ============================================================
             ACCOUNT / QUICK INFO
             ============================================================ -->

        <div class="col-12 col-lg-4">

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0">

                    <h5 class="fw-bold mb-0">
                        Account Information
                    </h5>

                </div>


                <div class="card-body">

                    <div class="d-flex align-items-start mb-3">

                        <div class="rounded-circle
                                    bg-primary-subtle
                                    text-primary
                                    p-2
                                    me-3">

                            <i class="bi bi-person-badge"></i>

                        </div>

                        <div>

                            <div class="fw-semibold">
                                Teacher Account
                            </div>

                            <div class="text-muted small">
                                This teacher has a school login account.
                            </div>

                        </div>

                    </div>


                    <div class="d-flex align-items-start">

                        <div class="rounded-circle
                                    bg-success-subtle
                                    text-success
                                    p-2
                                    me-3">

                            <i class="bi bi-shield-check"></i>

                        </div>

                        <div>

                            <div class="fw-semibold">
                                Teacher Role
                            </div>

                            <div class="text-muted small">
                                The account is assigned the Teacher role.
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ========================================================
                 QUICK ACTIONS
                 ======================================================== -->

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0">

                    <h5 class="fw-bold mb-0">
                        Quick Actions
                    </h5>

                </div>


                <div class="card-body">

                    <a asp-controller="Teachers"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary w-100 mb-2">

                        <i class="bi bi-pencil-square me-2"></i>
                        Edit Teacher

                    </a>


                    <a asp-controller="Teachers"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100">

                        <i class="bi bi-people me-2"></i>
                        All Teachers

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         ASSIGNED CLASSES
         ============================================================ -->

    <div class="card border-0 shadow-sm mt-4">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex
                        justify-content-between
                        align-items-center">

                <div>

                    <h2 class="h5 fw-bold mb-1">
                        Assigned Classes
                    </h2>

                    <div class="text-muted small">
                        Classes currently assigned to this teacher.
                    </div>

                </div>


                <div class="text-muted">

                    <i class="bi bi-building me-1"></i>

                    @Model.ClassCount
                    @(Model.ClassCount == 1
                        ? " Class"
                        : " Classes")

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Classes.Count == 0)
            {
                <div class="text-center py-5 px-4">

                    <div class="rounded-circle
                                bg-light
                                d-inline-flex
                                align-items-center
                                justify-content-center
                                mb-3"
                         style="width:72px;height:72px;">

                        <i class="bi bi-building
                                  fs-2
                                  text-muted"></i>

                    </div>


                    <h3 class="h5 fw-bold">
                        No classes assigned
                    </h3>


                    <p class="text-muted mb-0">
                        This teacher has not been assigned to
                        any classes yet.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover
                                  align-middle
                                  mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Class
                                </th>

                                <th>
                                    Section
                                </th>

                                <th>
                                    Academic Year
                                </th>

                                <th>
                                    Room
                                </th>

                                <th>
                                    Students
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var schoolClass in Model.Classes)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <div class="fw-semibold">
                                            @schoolClass.ClassName
                                        </div>

                                    </td>


                                    <td>
                                        @schoolClass.Section
                                    </td>


                                    <td>
                                        @schoolClass.AcademicYear
                                    </td>


                                    <td>

                                        @if (schoolClass.RoomNumber.HasValue)
                                        {
                                            @schoolClass.RoomNumber
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not assigned
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <span class="badge
                                                     bg-primary-subtle
                                                     text-primary">

                                            @schoolClass.StudentCount

                                            @(schoolClass.StudentCount == 1
                                                ? " Student"
                                                : " Students")

                                        </span>

                                    </td>


                                    <td>

                                        @if (schoolClass.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>