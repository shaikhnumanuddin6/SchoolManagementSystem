@model SchoolManagementSystem.Application.ViewModels.Subjects.SubjectDetailsViewModel

@{
    ViewData["Title"] = "Subject Details";
}

<div class="container py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-4">
        <a asp-controller="Subjects"
           asp-action="Index"
           class="text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Back to Subjects
        </a>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">@Model.SubjectName</h2>
            <p class="text-muted mb-0">
                Subject Code: @Model.SubjectCode
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Subjects"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i> Edit Subject
            </a>

            @if (Model.IsActive)
            {
                <form asp-controller="Subjects"
                      asp-action="Archive"
                      asp-route-id="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Archive this subject?');">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-archive me-1"></i> Archive
                    </button>
                </form>
            }
            else
            {
                <form asp-controller="Subjects"
                      asp-action="Restore"
                      asp-route-id="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Restore this subject?');">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-outline-success">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Restore
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Subject Information</h5>
        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="text-muted small mb-1">Subject Name</div>
                    <div class="fw-semibold">@Model.SubjectName</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small mb-1">Subject Code</div>
                    <div class="fw-semibold">@Model.SubjectCode</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small mb-1">Status</div>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Archived</span>
                    }
                </div>

                <div class="col-md-6">
                    <div class="text-muted small mb-1">Created Date</div>
                    <div>@Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")</div>
                </div>

                <div class="col-12">
                    <div class="text-muted small mb-1">Description</div>

                    @if (string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted mb-0">
                            No description has been provided.
                        </p>
                    }
                    else
                    {
                        <p class="mb-0" style="white-space: pre-wrap;">@Model.Description</p>
                    }
                </div>

            </div>
        </div>
    </div>

</div>