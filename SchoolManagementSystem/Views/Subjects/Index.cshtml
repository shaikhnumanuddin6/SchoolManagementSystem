@model SchoolManagementSystem.Application.ViewModels.Subjects.SubjectListViewModel

@{
    ViewData["Title"] = "Subject Management";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Subject Management</h2>
            <p class="text-muted mb-0">
                Manage your school's subjects and subject codes.
            </p>
        </div>

        <a asp-controller="Subjects"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Subject
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Subjects</div>
                    <div class="fs-2 fw-bold">@Model.TotalSubjects</div>
                    <i class="bi bi-book text-primary"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Active Subjects</div>
                    <div class="fs-2 fw-bold text-success">@Model.ActiveSubjects</div>
                    <i class="bi bi-check-circle text-success"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Archived Subjects</div>
                    <div class="fs-2 fw-bold text-secondary">@Model.InactiveSubjects</div>
                    <i class="bi bi-archive text-secondary"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Search and filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <form asp-controller="Subjects"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-6 col-md-6">
                        <label for="searchTerm" class="form-label">
                            Search Subjects
                        </label>

                        <input id="searchTerm"
                               type="text"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Subject name, code, or description..." />
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label for="status" class="form-label">Status</label>

                        <select id="status" name="status" class="form-select">
                            @if (string.IsNullOrWhiteSpace(Model.Status))
                            {
                                <option value="" selected>All Statuses</option>
                            }
                            else
                            {
                                <option value="">All Statuses</option>
                            }

                            @if (string.Equals(
                            Model.Status,
                            "Active",
                            StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="Active" selected>Active</option>
                            }
                            else
                            {
                                <option value="Active">Active</option>
                            }

                            @if (string.Equals(
                            Model.Status,
                            "Inactive",
                            StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="Inactive" selected>Archived</option>
                            }
                            else
                            {
                                <option value="Inactive">Archived</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-1"></i> Filter
                        </button>

                        <a asp-controller="Subjects"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>
                    </div>

                </div>
            </form>

        </div>
    </div>

    <!-- Subjects table -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Subjects</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.Subjects.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-book display-4 text-muted"></i>

                    <h5 class="mt-3">No subjects found</h5>

                    <p class="text-muted">
                        Add a subject or adjust your search filters.
                    </p>

                    <a asp-controller="Subjects"
                       asp-action="Create"
                       class="btn btn-primary">
                        Add First Subject
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Subject Code</th>
                                <th>Subject Name</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var subject in Model.Subjects)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            @subject.SubjectCode
                                        </span>
                                    </td>

                                    <td>@subject.SubjectName</td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(subject.Description))
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            <span>
                                                @(subject.Description.Length > 70
                                                    ? subject.Description[..70] + "..."
                                                    : subject.Description)
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (subject.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Archived</span>
                                        }
                                    </td>

                                    <td>
                                        @subject.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-end">
                                        <div class="d-inline-flex flex-wrap gap-1">

                                            <a asp-controller="Subjects"
                                               asp-action="Details"
                                               asp-route-id="@subject.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Details
                                            </a>

                                            <a asp-controller="Subjects"
                                               asp-action="Edit"
                                               asp-route-id="@subject.Id"
                                               class="btn btn-sm btn-outline-warning">
                                                Edit
                                            </a>

                                            @if (subject.IsActive)
                                            {
                                                <form asp-controller="Subjects"
                                                      asp-action="Archive"
                                                      asp-route-id="@subject.Id"
                                                      method="post"
                                                      onsubmit="return confirm('Archive this subject? Existing grade records will be retained.');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        Archive
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Subjects"
                                                      asp-action="Restore"
                                                      asp-route-id="@subject.Id"
                                                      method="post"
                                                      onsubmit="return confirm('Restore this subject?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        Restore
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>