
@model SchoolManagementSystem.Application.ViewModels.Timetable.TimetableListViewModel

@{
    ViewData["Title"] = "Timetable Management";

    var days = new Dictionary<int, string>
    {
        { 1, "Monday" },
        { 2, "Tuesday" },
        { 3, "Wednesday" },
        { 4, "Thursday" },
        { 5, "Friday" },
        { 6, "Saturday" },
        { 7, "Sunday" }
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Timetable Management</h2>
            <p class="text-muted mb-0">Manage class schedules and teacher assignments.</p>
        </div>

        <a asp-controller="Timetable"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Timetable Entry
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="Timetable" asp-action="Index" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label asp-for="ClassId" class="form-label">Class</label>
                        <select asp-for="ClassId"
                                asp-items="Model.Classes"
                                class="form-select">
                            <option value="">All Classes</option>
                        </select>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="DayOfWeek" class="form-label">Day</label>
                        <select asp-for="DayOfWeek" class="form-select">
                            <option value="">All Days</option>
                            @foreach (var day in days)
                            {
                                <option value="@day.Key">@day.Value</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            Filter
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Scheduled Lessons</h5>
        </div>

        <div class="card-body p-0">
            @if (Model.Timetables.Count == 0)
            {
                <div class="text-center py-5">
                    <h5>No timetable entries found</h5>
                    <p class="text-muted mb-3">
                        Add a lesson to start building the timetable.
                    </p>
                    <a asp-action="Create" class="btn btn-primary">
                        Add First Entry
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Class</th>
                                <th>Day</th>
                                <th>Time</th>
                                <th>Subject</th>
                                <th>Teacher</th>
                                <th>Room</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Timetables)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@item.ClassName</span>
                                    </td>
                                    <td>@item.DayName</td>
                                    <td>
                                        @item.StartTime.ToString(@"hh\:mm")
                                        -
                                        @item.EndTime.ToString(@"hh\:mm")
                                    </td>
                                    <td>@item.SubjectName</td>
                                    <td>@item.TeacherName</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.RoomNumber)
                                            ? "—"
                                            : item.RoomNumber)
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this timetable entry?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
