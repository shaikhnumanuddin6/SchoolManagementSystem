@using Microsoft.AspNetCore.Identity
@using SchoolManagementSystem.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var displayName = currentUser?.FullName ?? User.Identity?.Name ?? "User";
    var displayRole = currentUser?.UserRole ?? (User.IsInRole("Admin") ? "Admin" : User.IsInRole("Teacher") ? "Teacher" : "Student");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - School Management System</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <div class="app-wrapper">

        <!-- ================= SIDEBAR ================= -->
        <aside class="sidebar" id="sidebar">

            <div class="sidebar-header">
                <div class="school-logo">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <div class="school-info">
                    <h5>EduManage</h5>
                    <span>School System</span>
                </div>
            </div>

            <div class="sidebar-menu">

                @if (User.IsInRole("Student"))
                {
                    <div class="menu-title">STUDENT PORTAL</div>

                    <a asp-controller="Student"
                       asp-action="Dashboard"
                       class="menu-item">
                        <i class="bi bi-speedometer2"></i>
                        <span>My Dashboard</span>
                    </a>

                    <div class="menu-title">ACADEMICS</div>

                    <a asp-controller="Student" asp-action="Dashboard" class="menu-item">
                        <i class="bi bi-bar-chart-line-fill"></i>
                        <span>My Grades</span>
                    </a>

                    <a asp-controller="Student" asp-action="Dashboard" class="menu-item">
                        <i class="bi bi-calendar-check-fill"></i>
                        <span>My Attendance</span>
                    </a>
                }
                else
                {
                    <div class="menu-title">MAIN</div>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="menu-item">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>

                    <div class="menu-title">ACADEMIC</div>

                    <a href="#" class="menu-item">
                        <i class="bi bi-people-fill"></i>
                        <span>Students</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="bi bi-person-workspace"></i>
                        <span>Teachers</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="bi bi-building"></i>
                        <span>Classes</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="bi bi-journal-text"></i>
                        <span>Subjects</span>
                    </a>

                    <div class="menu-title">MANAGEMENT</div>

                    <a href="#" class="menu-item">
                        <i class="bi bi-calendar-check-fill"></i>
                        <span>Attendance</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="bi bi-bar-chart-fill"></i>
                        <span>Grades</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="bi bi-megaphone-fill"></i>
                        <span>Announcements</span>
                    </a>

                    <div class="menu-title">AI FEATURES</div>

                    <a href="#" class="menu-item ai-menu-item">
                        <i class="bi bi-stars"></i>
                        <span>AI Dashboard</span>
                        <span class="ai-badge">AI</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="bi bi-robot"></i>
                        <span>AI Insights</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Risk Predictor</span>
                    </a>
                }

                <div class="menu-title">SYSTEM</div>

                <form asp-controller="Account" asp-action="Logout" method="post" class="d-block w-100">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="menu-item text-danger border-0 bg-transparent w-100 text-start">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Sign Out</span>
                    </button>
                </form>

            </div>

            <div class="sidebar-footer">

                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="sidebar-user">

                        <div class="user-avatar">
                            @(displayName?.Substring(0, 1).ToUpper() ?? "U")
                        </div>

                        <div class="user-info">
                            <strong>@displayName</strong>
                            <small>@displayRole</small>
                        </div>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="ms-auto d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-link text-muted p-0" title="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>

                    </div>
                }

            </div>

        </aside>


        <!-- ================= MAIN CONTENT ================= -->
        <div class="main-content">

            <!-- TOP NAVBAR -->
            <header class="top-navbar">

                <div class="navbar-left">

                    <button class="sidebar-toggle"
                            id="sidebarToggle">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="breadcrumb-area">
                        <span class="breadcrumb-label">
                            EduManage
                        </span>
                        <span class="breadcrumb-separator">/</span>
                        <span class="breadcrumb-current">
                            @ViewData["Title"]
                        </span>
                    </div>

                </div>

                <div class="navbar-right">

                    <div class="top-search">
                        <i class="bi bi-search"></i>
                        <input type="text"
                               placeholder="Search..." />
                        <span class="search-shortcut">⌘K</span>
                    </div>

                    <!-- Notifications -->
                    <button class="navbar-icon-btn">
                        <i class="bi bi-bell"></i>
                        <span class="notification-dot"></span>
                    </button>

                    <!-- Messages -->
                    <button class="navbar-icon-btn">
                        <i class="bi bi-chat-left-text"></i>
                    </button>

                    <!-- User Dropdown -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown">
                            <div class="top-user cursor-pointer" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                                <div class="top-user-avatar">
                                    @(displayName?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                                <div class="top-user-info">
                                    <strong>@displayName</strong>
                                    <span>@displayRole</span>
                                </div>
                                <i class="bi bi-chevron-down"></i>
                            </div>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 p-2" style="border-radius: 12px; min-width: 210px;">
                                <li class="px-3 py-2 border-bottom mb-2">
                                    <div class="fw-bold text-dark">@displayName</div>
                                    <div class="text-muted small">@currentUser?.Email</div>
                                    <span class="badge bg-primary-subtle text-primary mt-1">@displayRole</span>
                                </li>
                                @if (User.IsInRole("Student"))
                                {
                                    <li>
                                        <a class="dropdown-item rounded py-2" asp-controller="Student" asp-action="Dashboard">
                                            <i class="bi bi-person-badge me-2 text-primary"></i> Student Portal
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item rounded py-2" asp-controller="Home" asp-action="Index">
                                            <i class="bi bi-grid-1x2-fill me-2 text-primary"></i> Main Dashboard
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger rounded py-2">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </a>
                    }

                </div>

            </header>


            <!-- PAGE CONTENT -->
            <main class="page-content">

                @RenderBody()

            </main>


            <!-- FOOTER -->
            <footer class="app-footer">

                <span>
                    © @DateTime.Now.Year EduManage
                </span>

                <span>
                    School Management System
                </span>

            </footer>

        </div>

    </div>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Application JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
