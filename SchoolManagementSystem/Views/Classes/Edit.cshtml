@model SchoolManagementSystem.Application.ViewModels.Classes.ClassEditViewModel

@{
    ViewData["Title"] = "Edit Class";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-controller="Classes" asp-action="Index"
           class="text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Back to Classes
        </a>

        <h2 class="fw-bold mt-3 mb-1">Edit Class</h2>
        <p class="text-muted">
            Update class information and teacher assignment.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="Classes"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="ClassName" class="form-label"></label>
                        <input asp-for="ClassName" class="form-control" />
                        <span asp-validation-for="ClassName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Section" class="form-label"></label>
                        <input asp-for="Section" class="form-control" />
                        <span asp-validation-for="Section"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AcademicYear" class="form-label"></label>
                        <input asp-for="AcademicYear" class="form-control" />
                        <span asp-validation-for="AcademicYear"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RoomNumber" class="form-label"></label>
                        <input asp-for="RoomNumber"
                               type="number"
                               class="form-control"
                               min="1" />
                        <span asp-validation-for="RoomNumber"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="TeacherId" class="form-label"></label>

                        <select asp-for="TeacherId"
                                asp-items="Model.Teachers"
                                class="form-select">
                        </select>

                        <div class="form-text">
                            Select a different teacher or choose Not Assigned.
                            An existing inactive teacher may remain assigned until changed.
                        </div>

                        <span asp-validation-for="TeacherId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">
                                Class is active
                            </label>
                        </div>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2">

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>

                    <a asp-controller="Classes"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}