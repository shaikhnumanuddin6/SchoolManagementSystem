@model SchoolManagementSystem.Application.ViewModels.Classes.ClassListViewModel

@{
    ViewData["Title"] = "Class Management";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Class Management</h2>
            <p class="text-muted mb-0">
                Manage classes, sections, academic years, and teacher assignments.
            </p>
        </div>

        <a asp-controller="Classes"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Create Class
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Classes</div>
                    <div class="fs-2 fw-bold">@Model.TotalClasses</div>
                    <i class="bi bi-building text-primary"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Active Classes</div>
                    <div class="fs-2 fw-bold text-success">@Model.ActiveClasses</div>
                    <i class="bi bi-check-circle text-success"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Archived Classes</div>
                    <div class="fs-2 fw-bold text-secondary">@Model.InactiveClasses</div>
                    <i class="bi bi-archive text-secondary"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Search and filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <form asp-controller="Classes"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-4 col-md-6">
                        <label for="searchTerm" class="form-label">
                            Search Classes
                        </label>

                        <input id="searchTerm"
                               type="text"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Class, section, teacher, room..." />
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label for="academicYear" class="form-label">
                            Academic Year
                        </label>

                        <select id="academicYear"
                                name="academicYear"
                                class="form-select">

                            @if (string.IsNullOrWhiteSpace(Model.AcademicYear))
                            {
                                <option value="" selected>All Academic Years</option>
                            }
                            else
                            {
                                <option value="">All Academic Years</option>
                            }

                            @foreach (var year in Model.AcademicYears)
                            {
                                if (string.Equals(
                                Model.AcademicYear,
                                year,
                                StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@year" selected>@year</option>
                                }
                                else
                                {
                                    <option value="@year">@year</option>
                                }
                            }

                        </select>
                    </div>

                    <div class="col-lg-2 col-md-6">
                        <label for="status" class="form-label">Status</label>

                        <select id="status" name="status" class="form-select">
                            @if (string.IsNullOrWhiteSpace(Model.Status))
                            {
                                <option value="" selected>All Statuses</option>
                            }
                            else
                            {
                                <option value="">All Statuses</option>
                            }

                            @if (string.Equals(
                            Model.Status, "Active",
                            StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="Active" selected>Active</option>
                            }
                            else
                            {
                                <option value="Active">Active</option>
                            }

                            @if (string.Equals(
                            Model.Status, "Inactive",
                            StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="Inactive" selected>Archived</option>
                            }
                            else
                            {
                                <option value="Inactive">Archived</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-1"></i> Filter
                        </button>

                        <a asp-controller="Classes"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>
                    </div>

                </div>

            </form>
        </div>
    </div>

    <!-- Class list -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Classes</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.Classes.Count == 0)
            {
                <div class="text-center py-5">

                    <i class="bi bi-building display-4 text-muted"></i>

                    <h5 class="mt-3">No classes found</h5>

                    <p class="text-muted">
                        Create a class or change your search filters.
                    </p>

                    <a asp-controller="Classes"
                       asp-action="Create"
                       class="btn btn-primary">
                        Create First Class
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Class</th>
                                <th>Academic Year</th>
                                <th>Room</th>
                                <th>Assigned Teacher</th>
                                <th>Students</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Classes)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @item.ClassName - @item.Section
                                        </div>
                                        <div class="small text-muted">
                                            Class ID: @item.Id
                                        </div>
                                    </td>

                                    <td>@item.AcademicYear</td>

                                    <td>
                                        @(item.RoomNumber?.ToString() ?? "Not set")
                                    </td>

                                    <td>@item.TeacherName</td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.StudentCount
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Archived</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-inline-flex flex-wrap gap-1">

                                            <a asp-controller="Classes"
                                               asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Details
                                            </a>

                                            <a asp-controller="Classes"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-warning">
                                                Edit
                                            </a>

                                            @if (item.IsActive)
                                            {
                                                <form asp-controller="Classes"
                                                      asp-action="Archive"
                                                      asp-route-id="@item.Id"
                                                      method="post"
                                                      onsubmit="return confirm('Archive this class? Existing student, grade and attendance records will be retained.');">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        Archive
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Classes"
                                                      asp-action="Restore"
                                                      asp-route-id="@item.Id"
                                                      method="post"
                                                      onsubmit="return confirm('Restore this class?');">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        Restore
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>