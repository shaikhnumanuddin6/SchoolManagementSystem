@model SchoolManagementSystem.Domain.Entities.Announcement

@{
    ViewData["Title"] = "Edit Announcement";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a asp-controller="Announcements"
           asp-action="Index"
           class="text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Back to Announcements
        </a>

        <h2 class="fw-bold mt-3 mb-1">Edit Announcement</h2>
        <p class="text-muted mb-0">
            Update the announcement details below.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-controller="Announcements"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="CreatedAt" type="hidden" />
                <input asp-for="CreatedByUserId" type="hidden" />
                <input asp-for="IsPublished" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">
                        Announcement Title
                    </label>
                    <input asp-for="Title"
                           class="form-control"
                           maxlength="150" />
                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label fw-semibold">
                        Announcement Details
                    </label>
                    <textarea asp-for="Content"
                              class="form-control"
                              rows="6"
                              maxlength="5000"></textarea>
                    <span asp-validation-for="Content"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TargetAudience"
                           class="form-label fw-semibold">
                        Target Audience
                    </label>
                    <select asp-for="TargetAudience" class="form-select">
                        <option value="Everyone">Everyone</option>
                        <option value="Students">Students</option>
                        <option value="Teachers">Teachers</option>
                    </select>
                    <span asp-validation-for="TargetAudience"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PublishAt"
                               class="form-label fw-semibold">
                            Schedule Publish Date (Optional)
                        </label>
                        <input asp-for="PublishAt"
                               type="datetime-local"
                               class="form-control"
                               value="@Model.PublishAt?.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="PublishAt"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ExpiresAt"
                               class="form-label fw-semibold">
                            Expiry Date (Optional)
                        </label>
                        <input asp-for="ExpiresAt"
                               type="datetime-local"
                               class="form-control"
                               value="@Model.ExpiresAt?.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="ExpiresAt"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>
                        Save Changes
                    </button>

                    <a asp-controller="Announcements"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
