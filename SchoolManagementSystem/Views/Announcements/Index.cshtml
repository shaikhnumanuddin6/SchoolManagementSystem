
@model List<SchoolManagementSystem.Domain.Entities.Announcement>

@{
    ViewData["Title"] = "Announcements";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Announcements</h2>
            <p class="text-muted mb-0">Manage school announcements</p>
        </div>

        <a asp-controller="Announcements"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Create Announcement
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-megaphone display-4 text-muted"></i>
                    <h5 class="mt-3">No announcements yet</h5>
                    <p class="text-muted">Create your first school announcement.</p>

                    <a asp-controller="Announcements"
                       asp-action="Create"
                       class="btn btn-primary">
                        Create Announcement
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Audience</th>
                                <th>Created</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var announcement in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @announcement.Title
                                        </div>
                                        <div class="text-muted small">
                                            @(announcement.Content.Length > 100
                                                ? announcement.Content.Substring(0, 100) + "..."
                                                : announcement.Content)
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @announcement.TargetAudience
                                        </span>
                                    </td>

                                    <td>
                                        @announcement.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @if (announcement.IsPublished)
                                        {
                                            <span class="badge bg-success">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Draft</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-controller="Announcements"
                                               asp-action="Edit"
                                               asp-route-id="@announcement.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <form asp-controller="Announcements"
                                                  asp-action="TogglePublish"
                                                  asp-route-id="@announcement.Id"
                                                  method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">
                                                    @(announcement.IsPublished ? "Unpublish" : "Publish")
                                                </button>
                                            </form>

                                            <form asp-controller="Announcements"
                                                  asp-action="Delete"
                                                  asp-route-id="@announcement.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this announcement?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
