 @model SchoolManagementSystem.Application.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4 admin-dashboard">

    <!-- Welcome header -->
    <section class="dashboard-welcome mb-4">
        <div class="welcome-content">
            <span class="welcome-eyebrow">
                <i class="bi bi-stars me-2"></i>ADMIN OVERVIEW
            </span>
            <h1>Welcome back! <span class="welcome-wave">👋</span></h1>
            <p>Here's what's happening at your school today.</p>
            <div class="welcome-date">
                <i class="bi bi-calendar3"></i>
                @DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </div>
        </div>
        <div class="welcome-decoration" aria-hidden="true">
            <i class="bi bi-mortarboard-fill"></i>
        </div>
    </section>

    <!-- Statistics -->
    <div class="row g-3 g-xl-4 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-card stat-card stat-students h-100">
                <div class="stat-card-content">
                    <div>
                        <span class="stat-label">Total Students</span>
                        <h2>@Model.TotalStudents.ToString("N0")</h2>
                        <span class="stat-description">
                            <i class="bi bi-people-fill"></i> Enrolled students
                        </span>
                    </div>
                    <div class="stat-icon students-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="stat-bottom-line"></div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-card stat-card stat-teachers h-100">
                <div class="stat-card-content">
                    <div>
                        <span class="stat-label">Total Teachers</span>
                        <h2>@Model.TotalTeachers.ToString("N0")</h2>
                        <span class="stat-description">
                            <i class="bi bi-person-workspace"></i> Teaching staff
                        </span>
                    </div>
                    <div class="stat-icon teachers-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>
                </div>
                <div class="stat-bottom-line"></div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-card stat-card stat-classes h-100">
                <div class="stat-card-content">
                    <div>
                        <span class="stat-label">Total Classes</span>
                        <h2>@Model.TotalClasses.ToString("N0")</h2>
                        <span class="stat-description">
                            <i class="bi bi-building"></i> School classes
                        </span>
                    </div>
                    <div class="stat-icon classes-icon">
                        <i class="bi bi-building"></i>
                    </div>
                </div>
                <div class="stat-bottom-line"></div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-card stat-card stat-attendance h-100">
                <div class="stat-card-content">
                    <div>
                        <span class="stat-label">Today's Attendance</span>
                        <h2>@Model.AttendancePercentage.ToString("0.0")%</h2>
                        <span class="stat-description">
                            <i class="bi bi-calendar-check"></i>
                            @Model.AttendanceRecordsToday records
                        </span>
                    </div>
                    <div class="stat-icon attendance-icon">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                </div>
                <div class="stat-bottom-line"></div>
            </div>
        </div>

    </div>

    <!-- Attendance and academic performance -->
    <div class="row g-3 g-xl-4 mb-4">

        <div class="col-12 col-xl-8">
            <section class="dashboard-card dashboard-panel h-100">
                <div class="card-header-custom">
                    <div>
                        <h5><i class="bi bi-calendar2-check me-2 text-primary"></i>Today's Attendance</h5>
                        <p>School-wide attendance overview</p>
                    </div>
                    <span class="panel-chip">Today</span>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-12 col-sm-4">
                        <div class="attendance-metric metric-present">
                            <div class="metric-icon"><i class="bi bi-check-circle-fill"></i></div>
                            <div class="text-muted small">Present</div>
                            <div class="metric-value">@Model.PresentToday</div>
                            <div class="metric-caption">Students present</div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="attendance-metric metric-absent">
                            <div class="metric-icon"><i class="bi bi-x-circle-fill"></i></div>
                            <div class="text-muted small">Absent</div>
                            <div class="metric-value">@Model.AbsentToday</div>
                            <div class="metric-caption">Students absent</div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="attendance-metric metric-late">
                            <div class="metric-icon"><i class="bi bi-clock-fill"></i></div>
                            <div class="text-muted small">Late</div>
                            <div class="metric-value">@Model.LateToday</div>
                            <div class="metric-caption">Arrived late</div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="dashboard-card dashboard-panel performance-highlight h-100">
                <div class="card-header-custom">
                    <div>
                        <h5><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Academic Performance</h5>
                        <p>Overall grade average</p>
                    </div>
                </div>

                <div class="performance-summary">
                    <div class="performance-ring"
                         style="--performance-value: @Math.Clamp(Model.AverageGradePercentage, 0, 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%">
                        <div class="performance-ring-inner">
                            <strong>@Model.AverageGradePercentage.ToString("0.0")%</strong>
                            <span>Average</span>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Overall student performance</p>
                    <span class="dashboard-pill">
                        <i class="bi bi-journal-check me-1"></i>
                        @Model.TotalGrades grades recorded
                    </span>
                </div>
            </section>
        </div>

    </div>

    <!-- Class-wise attendance -->
    <section class="dashboard-card dashboard-panel mb-4">
        <div class="card-header-custom">
            <div>
                <h5><i class="bi bi-buildings me-2 text-primary"></i>Class-wise Attendance</h5>
                <p>Attendance overview for every class</p>
            </div>
            <span class="dashboard-pill">
                @Model.ClassAttendance.Count Classes
            </span>
        </div>

        <div class="table-responsive dashboard-table-wrap mt-3">
            @if (Model.ClassAttendance.Any())
            {
                <table class="table table-hover align-middle dashboard-table">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Teacher</th>
                            <th>Students</th>
                            <th>Present</th>
                            <th>Absent</th>
                            <th>Late</th>
                            <th>Attendance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ClassAttendance)
                        {
                            var attendanceValue = Math.Clamp(item.AttendancePercentage, 0, 100);

                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.ClassName - @item.Section</div>
                                    <div class="small text-muted">@item.AcademicYear</div>
                                </td>
                                <td>@item.TeacherName</td>
                                <td><span class="count-pill count-blue">@item.StudentCount</span></td>
                                <td><span class="status-number text-success">@item.PresentCount</span></td>
                                <td><span class="status-number text-danger">@item.AbsentCount</span></td>
                                <td><span class="status-number text-warning">@item.LateCount</span></td>
                                <td style="min-width: 175px;">
                                    <div class="d-flex justify-content-between mb-2">
                                        <small class="fw-semibold">@item.AttendancePercentage.ToString("0.0")%</small>
                                    </div>
                                    <div class="progress dashboard-progress" role="progressbar"
                                         aria-label="Class attendance"
                                         aria-valuenow="@attendanceValue"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        <div class="progress-bar attendance-progress"
                                             style="width: @attendanceValue.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="dashboard-empty">
                    <div class="empty-icon"><i class="bi bi-building"></i></div>
                    <h6>No classes found</h6>
                    <p>Create classes to see class-wise attendance.</p>
                </div>
            }
        </div>
    </section>

    <!-- Subject performance and attendance summary -->
    <div class="row g-3 g-xl-4 mb-4">

        <div class="col-12 col-xl-8">
            <section class="dashboard-card dashboard-panel h-100">
                <div class="card-header-custom">
                    <div>
                        <h5><i class="bi bi-bar-chart-line me-2 text-primary"></i>Student Performance</h5>
                        <p>Average performance by subject</p>
                    </div>
                </div>

                <div class="subject-performance mt-4">
                    @if (Model.PerformanceData.Any())
                    {
                        foreach (var item in Model.PerformanceData)
                        {
                            var performanceValue = Math.Clamp(item.Value, 0, 100);

                            <div class="subject-row">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-semibold subject-name">@item.Label</span>
                                    <span class="subject-score">@item.Value.ToString("0.0")%</span>
                                </div>
                                <div class="progress dashboard-progress" role="progressbar"
                                     aria-label="@item.Label performance"
                                     aria-valuenow="@performanceValue"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    <div class="progress-bar subject-progress"
                                         style="width: @performanceValue.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="dashboard-empty">
                            <div class="empty-icon"><i class="bi bi-bar-chart-line"></i></div>
                            <h6>No performance data yet</h6>
                            <p>Grade data will appear here when available.</p>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="dashboard-card dashboard-panel h-100">
                <div class="card-header-custom">
                    <div>
                        <h5><i class="bi bi-clipboard-data me-2 text-primary"></i>Attendance Summary</h5>
                        <p>Today's figures</p>
                    </div>
                </div>

                <div class="attendance-summary-list mt-3">
                    <div class="summary-row">
                        <span><i class="bi bi-check-circle-fill text-success"></i>Present</span>
                        <strong>@Model.PresentToday</strong>
                    </div>
                    <div class="summary-row">
                        <span><i class="bi bi-x-circle-fill text-danger"></i>Absent</span>
                        <strong>@Model.AbsentToday</strong>
                    </div>
                    <div class="summary-row">
                        <span><i class="bi bi-clock-fill text-warning"></i>Late</span>
                        <strong>@Model.LateToday</strong>
                    </div>
                </div>
            </section>
        </div>

    </div>

    <!-- Recent attendance and activity -->
    <div class="row g-3 g-xl-4">

        <div class="col-12 col-xl-7">
            <section class="dashboard-card dashboard-panel h-100">
                <div class="card-header-custom">
                    <div>
                        <h5><i class="bi bi-clock-history me-2 text-primary"></i>Recent Attendance</h5>
                        <p>Latest attendance records</p>
                    </div>
                </div>

                <div class="table-responsive dashboard-table-wrap mt-3">
                    @if (Model.RecentAttendance.Any())
                    {
                        <table class="table table-hover align-middle dashboard-table">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Class</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.RecentAttendance)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.StudentName</td>
                                        <td>
                                            @item.ClassName
                                            <span class="text-muted">@item.Section</span>
                                        </td>
                                        <td>
                                            @if (item.Status == "Present")
                                            {
                                                <span class="status-badge badge-present">
                                                    <i class="bi bi-check-circle-fill"></i> Present
                                                </span>
                                            }
                                            else if (item.Status == "Absent")
                                            {
                                                <span class="status-badge badge-absent">
                                                    <i class="bi bi-x-circle-fill"></i> Absent
                                                </span>
                                            }
                                            else if (item.Status == "Late")
                                            {
                                                <span class="status-badge badge-late">
                                                    <i class="bi bi-clock-fill"></i> Late
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge badge-other">@item.Status</span>
                                            }
                                        </td>
                                        <td class="text-nowrap">@item.Date.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="dashboard-empty">
                            <div class="empty-icon"><i class="bi bi-calendar-x"></i></div>
                            <h6>No attendance records yet</h6>
                            <p>Recent attendance entries will appear here.</p>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-5">
            <section class="dashboard-card dashboard-panel h-100">
                <div class="card-header-custom">
                    <div>
                        <h5><i class="bi bi-activity me-2 text-primary"></i>Recent Activity</h5>
                        <p>Latest school activity</p>
                    </div>
                </div>

                <div class="activity-feed mt-3">
                    @if (Model.RecentActivities.Any())
                    {
                        foreach (var activity in Model.RecentActivities)
                        {
                            <div class="activity-item">
                                <div class="activity-icon">
                                    <i class="bi @activity.Icon"></i>
                                </div>
                                <div class="activity-content">
                                    <div class="fw-semibold">@activity.Title</div>
                                    <div class="small text-muted">@activity.Description</div>
                                    <div class="activity-time">
                                        <i class="bi bi-clock me-1"></i>
                                        @activity.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="dashboard-empty">
                            <div class="empty-icon"><i class="bi bi-clock-history"></i></div>
                            <h6>No recent activity</h6>
                            <p>New school activity will appear here.</p>
                        </div>
                    }
                </div>
            </section>
        </div>

    </div>

</div>

@section Styles {
    <style>
        .admin-dashboard {
            --dash-blue: #2563eb;
            --dash-ink: #172033;
            --dash-muted: #718096;
            --dash-border: #e8edf5;
            --dash-surface: #ffffff;
            color: var(--dash-ink);
        }

        .dashboard-welcome {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            min-height: 205px;
            padding: clamp(24px, 4vw, 40px);
            overflow: hidden;
            border-radius: 24px;
            color: #fff;
            background: linear-gradient(115deg, #172554 0%, #1d4ed8 55%, #6366f1 100%);
            box-shadow: 0 14px 35px rgba(37, 99, 235, .17);
            animation: dashboard-enter .55s ease both;
        }

        .welcome-content {
            position: relative;
            z-index: 1;
        }

        .welcome-eyebrow {
            display: inline-flex;
            align-items: center;
            margin-bottom: 14px;
            padding: 7px 11px;
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 999px;
            background: rgba(255,255,255,.10);
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: 1.5px;
        }

        .dashboard-welcome h1 {
            margin: 0 0 9px;
            color: #fff;
            font-size: clamp(1.7rem, 3vw, 2.35rem);
            font-weight: 800;
            letter-spacing: -.8px;
        }

        .dashboard-welcome p {
            margin-bottom: 18px;
            color: rgba(255,255,255,.82);
        }

        .welcome-date {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #fff;
            font-size: .88rem;
            font-weight: 500;
        }

        .welcome-decoration {
            position: absolute;
            top: 50%;
            right: 7%;
            display: grid;
            width: 155px;
            height: 155px;
            place-items: center;
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 36px;
            background: rgba(255,255,255,.09);
            transform: translateY(-50%) rotate(-10deg);
            animation: welcome-float 5s ease-in-out infinite;
        }

        .welcome-decoration i {
            color: rgba(255,255,255,.92);
            font-size: 5rem;
        }

        .dashboard-card {
            min-width: 0;
            overflow: hidden;
            border: 1px solid var(--dash-border);
            border-radius: 18px;
            background: var(--dash-surface);
            box-shadow: 0 4px 18px rgba(15,23,42,.035);
            transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        }

        .dashboard-card:hover {
            border-color: #d7e3f7;
            box-shadow: 0 12px 28px rgba(15,23,42,.075);
        }

        .stat-card {
            position: relative;
            padding: 24px;
            animation: dashboard-enter .5s ease both;
        }

        .stat-card:nth-child(2) { animation-delay: .06s; }

        .stat-card-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .stat-label {
            display: block;
            margin-bottom: 12px;
            color: var(--dash-muted);
            font-size: .84rem;
            font-weight: 600;
        }

        .stat-card h2 {
            margin: 0 0 10px;
            color: var(--dash-ink);
            font-size: clamp(1.8rem, 2.5vw, 2.25rem);
            font-weight: 800;
            letter-spacing: -1px;
        }

        .stat-description {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--dash-muted);
            font-size: .78rem;
        }

        .stat-icon {
            display: grid;
            flex: 0 0 auto;
            width: 55px;
            height: 55px;
            place-items: center;
            border-radius: 16px;
            font-size: 1.45rem;
            transition: transform .25s ease;
        }

        .stat-card:hover .stat-icon {
            transform: scale(1.08) rotate(-5deg);
        }

        .students-icon { color: #2563eb; background: #eaf1ff; }
        .teachers-icon { color: #7c3aed; background: #f1eaff; }
        .classes-icon { color: #0891b2; background: #e4faff; }
        .attendance-icon { color: #059669; background: #e3fbf1; }

        .stat-bottom-line {
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            height: 3px;
            background: linear-gradient(90deg, #2563eb, #818cf8);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .3s ease;
        }

        .stat-card:hover .stat-bottom-line { transform: scaleX(1); }

        .dashboard-panel { padding: 25px; }

        .card-header-custom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
        }

        .card-header-custom h5 {
            margin: 0 0 6px;
            color: var(--dash-ink);
            font-size: 1.02rem;
            font-weight: 750;
        }

        .card-header-custom p {
            margin: 0;
            color: var(--dash-muted);
            font-size: .83rem;
        }

        .panel-chip, .dashboard-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 7px 11px;
            border: 1px solid #dbeafe;
            border-radius: 999px;
            background: #eff6ff;
            color: #1d4ed8;
            font-size: .76rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .attendance-metric {
            height: 100%;
            padding: 18px;
            border: 1px solid transparent;
            border-radius: 15px;
            transition: transform .2s ease;
        }

        .attendance-metric:hover { transform: translateY(-3px); }
        .metric-present { background: #ecfdf5; border-color: #d1fae5; }
        .metric-absent { background: #fff1f2; border-color: #ffe4e6; }
        .metric-late { background: #fffbeb; border-color: #fef3c7; }

        .metric-icon { margin-bottom: 12px; font-size: 1.2rem; }
        .metric-present .metric-icon { color: #059669; }
        .metric-absent .metric-icon { color: #e11d48; }
        .metric-late .metric-icon { color: #d97706; }

        .metric-value {
            margin: 3px 0;
            color: var(--dash-ink);
            font-size: 2rem;
            font-weight: 800;
            line-height: 1.25;
        }

        .metric-caption { color: var(--dash-muted); font-size: .76rem; }

        .performance-summary {
            display: flex;
            align-items: center;
            flex-direction: column;
            padding: 22px 0 8px;
        }

        .performance-ring {
            display: grid;
            width: 150px;
            height: 150px;
            margin-bottom: 16px;
            place-items: center;
            border-radius: 50%;
            background: conic-gradient(#2563eb calc(var(--performance-value) * 1%), #eaf0fb 0);
            position: relative;
        }

        .performance-ring::before {
            position: absolute;
            inset: 9px;
            border-radius: 50%;
            background: #fff;
            content: "";
        }

        .performance-ring-inner {
            position: relative;
            display: flex;
            align-items: center;
            flex-direction: column;
            gap: 3px;
        }

        .performance-ring-inner strong {
            color: var(--dash-ink);
            font-size: 1.7rem;
            font-weight: 800;
        }

        .performance-ring-inner span { color: var(--dash-muted); font-size: .78rem; }

        .dashboard-table-wrap { border-radius: 12px; }

        .dashboard-table {
            margin-bottom: 0;
            font-size: .86rem;
            white-space: nowrap;
        }

        .dashboard-table thead th {
            padding: 14px 15px;
            border-bottom: 1px solid var(--dash-border);
            background: #f8faff;
            color: #64748b;
            font-size: .72rem;
            font-weight: 750;
            letter-spacing: .45px;
            text-transform: uppercase;
        }

        .dashboard-table tbody td {
            padding: 15px;
            border-color: #eef2f7;
            color: #334155;
        }

        .dashboard-table tbody tr:last-child td { border-bottom: 0; }

        .dashboard-table tbody tr { transition: background .2s ease; }
        .dashboard-table tbody tr:hover { background: #f8faff; }

        .count-pill {
            display: inline-block;
            min-width: 32px;
            padding: 5px 9px;
            border-radius: 8px;
            text-align: center;
            font-size: .78rem;
            font-weight: 750;
        }

        .count-blue { background: #eff6ff; color: #1d4ed8; }
        .status-number { font-weight: 750; }

        .dashboard-progress {
            height: 8px;
            overflow: hidden;
            border-radius: 999px;
            background: #edf1f7;
