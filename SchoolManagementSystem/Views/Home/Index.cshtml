@model SchoolManagementSystem.Application.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="dashboard-header mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Welcome back! 👋
            </h1>

            <p class="text-muted mb-0">
                Here's what's happening at your school today.
            </p>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3 me-1"></i>
            @DateTime.Now.ToString("dddd, dd MMMM yyyy")
        </div>

    </div>


    <!-- =========================================================
         SUMMARY CARDS
         ========================================================= -->

    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card stat-card h-100">

                <div class="stat-card-content">

                    <div>
                        <span class="stat-label">
                            Total Students
                        </span>

                        <h2>
                            @Model.TotalStudents.ToString("N0")
                        </h2>

                        <span class="stat-description">
                            <i class="bi bi-people-fill"></i>
                            Students
                        </span>
                    </div>

                    <div class="stat-icon students-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card stat-card h-100">

                <div class="stat-card-content">

                    <div>
                        <span class="stat-label">
                            Total Teachers
                        </span>

                        <h2>
                            @Model.TotalTeachers.ToString("N0")
                        </h2>

                        <span class="stat-description">
                            <i class="bi bi-person-workspace"></i>
                            Teaching staff
                        </span>
                    </div>

                    <div class="stat-icon teachers-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card stat-card h-100">

                <div class="stat-card-content">

                    <div>
                        <span class="stat-label">
                            Total Classes
                        </span>

                        <h2>
                            @Model.TotalClasses.ToString("N0")
                        </h2>

                        <span class="stat-description">
                            <i class="bi bi-building"></i>
                            School classes
                        </span>
                    </div>

                    <div class="stat-icon classes-icon">
                        <i class="bi bi-building"></i>
                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card stat-card h-100">

                <div class="stat-card-content">

                    <div>
                        <span class="stat-label">
                            Today's Attendance
                        </span>

                        <h2>
                            @Model.AttendancePercentage.ToString("0.0")%
                        </h2>

                        <span class="stat-description">
                            @Model.AttendanceRecordsToday attendance records
                        </span>
                    </div>

                    <div class="stat-icon attendance-icon">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         ATTENDANCE SUMMARY
         ========================================================= -->

    <div class="row g-4 mb-4">

        <div class="col-xl-8">

            <div class="dashboard-card h-100">

                <div class="card-header-custom">

                    <div>
                        <h5 class="mb-1">
                            Today's Attendance
                        </h5>

                        <p class="text-muted mb-0">
                            School-wide attendance overview
                        </p>
                    </div>

                    <i class="bi bi-calendar-check dashboard-header-icon"></i>

                </div>

                <div class="row g-3 mt-2">

                    <div class="col-md-4">

                        <div class="p-3 rounded bg-success-subtle">

                            <div class="text-muted small">
                                Present
                            </div>

                            <div class="fs-3 fw-bold text-success">
                                @Model.PresentToday
                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="p-3 rounded bg-danger-subtle">

                            <div class="text-muted small">
                                Absent
                            </div>

                            <div class="fs-3 fw-bold text-danger">
                                @Model.AbsentToday
                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="p-3 rounded bg-warning-subtle">

                            <div class="text-muted small">
                                Late
                            </div>

                            <div class="fs-3 fw-bold text-warning-emphasis">
                                @Model.LateToday
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-4">

            <div class="dashboard-card h-100">

                <div class="card-header-custom">

                    <div>
                        <h5 class="mb-1">
                            Academic Performance
                        </h5>

                        <p class="text-muted mb-0">
                            Overall grade average
                        </p>
                    </div>

                    <i class="bi bi-bar-chart dashboard-header-icon"></i>

                </div>

                <div class="text-center py-4">

                    <div class="display-5 fw-bold">
                        @Model.AverageGradePercentage.ToString("0.0")%
                    </div>

                    <div class="text-muted">
                        Average performance
                    </div>

                    <div class="mt-2">
                        <span class="badge bg-primary">
                            @Model.TotalGrades grades recorded
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         CLASS-WISE ATTENDANCE
         ========================================================= -->

    <div class="dashboard-card mb-4">

        <div class="card-header-custom">

            <div>
                <h5 class="mb-1">
                    Class-wise Attendance
                </h5>

                <p class="text-muted mb-0">
                    Attendance for every class in the school
                </p>
            </div>

            <span class="badge bg-primary">
                @Model.ClassAttendance.Count Classes
            </span>

        </div>

        <div class="table-responsive mt-3">

            @if (Model.ClassAttendance.Any())
            {
                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Class</th>
                            <th>Teacher</th>
                            <th>Students</th>
                            <th>Present</th>
                            <th>Absent</th>
                            <th>Late</th>
                            <th>Attendance</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.ClassAttendance)
                        {
                            <tr>

                                <td>
                                    <div class="fw-semibold">
                                        @item.ClassName - @item.Section
                                    </div>

                                    <div class="small text-muted">
                                        @item.AcademicYear
                                    </div>
                                </td>

                                <td>
                                    @item.TeacherName
                                </td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @item.StudentCount
                                    </span>
                                </td>

                                <td>
                                    <span class="text-success fw-semibold">
                                        @item.PresentCount
                                    </span>
                                </td>

                                <td>
                                    <span class="text-danger fw-semibold">
                                        @item.AbsentCount
                                    </span>
                                </td>

                                <td>
                                    <span class="text-warning fw-semibold">
                                        @item.LateCount
                                    </span>
                                </td>

                                <td style="min-width: 180px;">

                                    <div class="d-flex justify-content-between mb-1">

                                        <small>
                                            @item.AttendancePercentage.ToString("0.0")%
                                        </small>

                                    </div>

                                    <div class="progress"
                                         style="height: 8px;">

                                        <div class="progress-bar"
                                             role="progressbar"
                                             style="width: @item.AttendancePercentage%;">
                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="text-center py-5 text-muted">

                    <i class="bi bi-building fs-1"></i>

                    <h6 class="mt-3">
                        No classes found
                    </h6>

                    <p class="mb-0">
                        Create classes to see class-wise attendance.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- =========================================================
         PERFORMANCE BY SUBJECT
         ========================================================= -->

    <div class="row g-4 mb-4">

        <div class="col-xl-8">

            <div class="dashboard-card h-100">

                <div class="card-header-custom">

                    <div>
                        <h5 class="mb-1">
                            Student Performance
                        </h5>

                        <p class="text-muted mb-0">
                            Average performance by subject
                        </p>
                    </div>

                    <i class="bi bi-bar-chart-line dashboard-header-icon"></i>

                </div>

                <div class="mt-3">

                    @if (Model.PerformanceData.Any())
                    {
                        foreach (var item in Model.PerformanceData)
                        {
                            <div class="mb-3">

                                <div class="d-flex justify-content-between mb-1">

                                    <span class="fw-semibold">
                                        @item.Label
                                    </span>

                                    <span>
                                        @item.Value.ToString("0.0")%
                                    </span>

                                </div>

                                <div class="progress"
                                     style="height: 10px;">

                                    <div class="progress-bar"
                                         role="progressbar"
                                         style="width: @item.Value%;">
                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">

                            <i class="bi bi-bar-chart fs-2"></i>

                            <p class="mt-2 mb-0">
                                No grade data available yet.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Attendance quick stats -->

        <div class="col-xl-4">

            <div class="dashboard-card h-100">

                <div class="card-header-custom">

                    <div>
                        <h5 class="mb-1">
                            Attendance Summary
                        </h5>

                        <p class="text-muted mb-0">
                            Today's figures
                        </p>
                    </div>

                </div>

                <div class="mt-3">

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">

                        <span>
                            <i class="bi bi-check-circle text-success me-2"></i>
                            Present
                        </span>

                        <strong>
                            @Model.PresentToday
                        </strong>

                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">

                        <span>
                            <i class="bi bi-x-circle text-danger me-2"></i>
                            Absent
                        </span>

                        <strong>
                            @Model.AbsentToday
                        </strong>

                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3">

                        <span>
                            <i class="bi bi-clock text-warning me-2"></i>
                            Late
                        </span>

                        <strong>
                            @Model.LateToday
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         RECENT ATTENDANCE
         ========================================================= -->

    <div class="row g-4">

        <div class="col-xl-7">

            <div class="dashboard-card h-100">

                <div class="card-header-custom">

                    <div>
                        <h5 class="mb-1">
                            Recent Attendance
                        </h5>

                        <p class="text-muted mb-0">
                            Latest attendance records
                        </p>
                    </div>

                </div>

                <div class="table-responsive mt-3">

                    @if (Model.RecentAttendance.Any())
                    {
                        <table class="table table-hover align-middle">

                            <thead class="table-light">

                                <tr>
                                    <th>Student</th>
                                    <th>Class</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model.RecentAttendance)
                                {
                                    <tr>

                                        <td>
                                            @item.StudentName
                                        </td>

                                        <td>
                                            @item.ClassName
                                            <span class="text-muted">
                                                @item.Section
                                            </span>
                                        </td>

                                        <td>

                                            @if (item.Status == "Present")
                                            {
                                                <span class="badge bg-success">
                                                    Present
                                                </span>
                                            }
                                            else if (item.Status == "Absent")
                                            {
                                                <span class="badge bg-danger">
                                                    Absent
                                                </span>
                                            }
                                            else if (item.Status == "Late")
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Late
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    @item.Status
                                                </span>
                                            }

                                        </td>

                                        <td>
                                            @item.Date.ToString("dd MMM yyyy")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">

                            <i class="bi bi-calendar-x fs-2"></i>

                            <p class="mt-2 mb-0">
                                No attendance records yet.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Recent activity -->

        <div class="col-xl-5">

            <div class="dashboard-card h-100">

                <div class="card-header-custom">

                    <div>
                        <h5 class="mb-1">
                            Recent Activity
                        </h5>

                        <p class="text-muted mb-0">
                            Latest school activity
                        </p>
                    </div>

                </div>

                <div class="mt-3">

                    @if (Model.RecentActivities.Any())
                    {
                        foreach (var activity in Model.RecentActivities)
                        {
                            <div class="d-flex gap-3 py-3 border-bottom">

                                <div>
                                    <i class="bi @activity.Icon fs-5"></i>
                                </div>

                                <div class="flex-grow-1">

                                    <div class="fw-semibold">
                                        @activity.Title
                                    </div>

                                    <div class="small text-muted">
                                        @activity.Description
                                    </div>

                                    <div class="small text-muted mt-1">
                                        @activity.CreatedAt.ToLocalTime()
                                            .ToString("dd MMM yyyy HH:mm")
                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">

                            <i class="bi bi-clock-history fs-2"></i>

                            <p class="mt-2 mb-0">
                                No recent activity.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>