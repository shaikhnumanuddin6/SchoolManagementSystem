@model SchoolManagementSystem.Application.ViewModels.Students.StudentListViewModel

@{
    ViewData["Title"] = "Students";

    string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "ST";

        var parts = fullName.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            return parts[0].Length >= 2
                ? parts[0][..2].ToUpperInvariant()
                : parts[0].ToUpperInvariant();
        }

        return $"{parts[0][0]}{parts[^1][0]}"
            .ToUpperInvariant();
    }
}

@section Styles {
    <style>
        .students-page {
            --student-primary: #4f46e5;
            --student-primary-light: #eef2ff;
            --student-border: #e8edf4;
            --student-muted: #64748b;
            color: #172033;
            animation: studentsFadeIn .45s ease-out;
        }

        @@keyframes studentsFadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .students-page .page-eyebrow {
            color: var(--student-primary);
            font-size: .75rem;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .students-page .page-title {
            font-size: clamp(1.6rem, 3vw, 2.15rem);
            font-weight: 800;
            letter-spacing: -.045em;
            color: #172033;
        }

        .students-page .page-description {
            color: var(--student-muted);
            font-size: .95rem;
        }

        .students-page .btn-add-student {
            border: 0;
            border-radius: 12px;
            background: var(--student-primary);
            color: white;
            padding: .8rem 1.2rem;
            font-weight: 700;
            box-shadow: 0 5px 14px rgba(79, 70, 229, .2);
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .students-page .btn-add-student:hover {
                background: #4338ca;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(79, 70, 229, .25);
            }

        .students-page .stat-card,
        .students-page .section-card {
            background: #fff;
            border: 1px solid var(--student-border);
            border-radius: 18px;
            box-shadow: 0 4px 18px rgba(15, 23, 42, .035);
        }

        .students-page .stat-card {
            height: 100%;
            padding: 1.35rem;
            position: relative;
            overflow: hidden;
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .students-page .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 28px rgba(15, 23, 42, .075);
            }

        .students-page .stat-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
        }

        .students-page .stat-label {
            color: var(--student-muted);
            font-size: .85rem;
            font-weight: 600;
            margin-bottom: .7rem;
        }

        .students-page .stat-value {
            color: #172033;
            font-size: 2rem;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -.04em;
        }

        .students-page .stat-icon {
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            font-size: 1.35rem;
        }

        .students-page .stat-footnote {
            margin-top: 1rem;
            color: #8490a3;
            font-size: .78rem;
        }

        .students-page .icon-indigo {
            background: #eef2ff;
            color: #4f46e5;
        }

        .students-page .icon-green {
            background: #dcfce7;
            color: #15803d;
        }

        .students-page .icon-gray {
            background: #f1f5f9;
            color: #64748b;
        }

        .students-page .section-card {
            overflow: hidden;
        }

        .students-page .filter-heading,
        .students-page .directory-heading {
            font-size: 1rem;
            font-weight: 800;
            color: #172033;
        }

        .students-page .form-label {
            color: #344054;
            font-size: .82rem;
            font-weight: 700;
            margin-bottom: .5rem;
        }

        .students-page .form-control,
        .students-page .form-select,
        .students-page .input-group-text {
            min-height: 44px;
            border-color: #e2e8f0;
            border-radius: 10px;
            font-size: .875rem;
        }

        .students-page .input-group-text {
            background: #f8fafc;
            color: #64748b;
        }

        .students-page .input-group > .input-group-text {
            border-radius: 10px 0 0 10px;
        }

        .students-page .input-group > .form-control {
            border-radius: 0 10px 10px 0;
        }

        .students-page .form-control:focus,
        .students-page .form-select:focus {
            border-color: #a5b4fc;
            box-shadow: 0 0 0 .2rem rgba(79, 70, 229, .1);
        }

        .students-page .btn-filter {
            min-height: 44px;
            background: var(--student-primary);
            border-color: var(--student-primary);
            color: white;
            border-radius: 10px;
            font-weight: 700;
        }

            .students-page .btn-filter:hover {
                background: #4338ca;
                color: white;
            }

        .students-page .btn-clear {
            min-height: 44px;
            min-width: 44px;
            border-radius: 10px;
        }

        .students-page .directory-header {
            padding: 1.4rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .students-page .directory-subtitle {
            color: var(--student-muted);
            font-size: .82rem;
            margin-top: .35rem;
        }

        .students-page .directory-count {
            background: var(--student-primary-light);
            color: var(--student-primary);
            border-radius: 999px;
            padding: .4rem .75rem;
            font-size: .78rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .students-page .student-table {
            width: 100%;
            margin: 0;
            border-collapse: separate;
            border-spacing: 0;
        }

            .students-page .student-table thead th {
                padding: .9rem 1rem;
                background: #f8fafc;
                color: #64748b;
                font-size: .72rem;
                font-weight: 800;
                letter-spacing: .055em;
                text-transform: uppercase;
                white-space: nowrap;
                border-top: 1px solid var(--student-border);
                border-bottom: 1px solid var(--student-border);
            }

                .students-page .student-table thead th:first-child,
                .students-page .student-table tbody td:first-child {
                    padding-left: 1.5rem;
                }

                .students-page .student-table thead th:last-child,
                .students-page .student-table tbody td:last-child {
                    padding-right: 1.5rem;
                }

            .students-page .student-table tbody td {
                padding: 1rem;
                border-bottom: 1px solid #eef2f7;
                vertical-align: middle;
                font-size: .875rem;
            }

            .students-page .student-table tbody tr {
                transition: background .18s ease;
            }

                .students-page .student-table tbody tr:hover {
                    background: #fafbff;
                }

                .students-page .student-table tbody tr:last-child td {
                    border-bottom: 0;
                }

        .students-page .student-avatar {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: #eef2ff;
            color: #4f46e5;
            font-size: .82rem;
            font-weight: 800;
        }

        .students-page .student-name {
            color: #172033;
            font-weight: 750;
            margin-bottom: .25rem;
        }

        .students-page .student-email {
            color: #8490a3;
            font-size: .78rem;
            overflow-wrap: anywhere;
        }

        .students-page .admission-number {
            color: #344054;
            font-weight: 700;
            white-space: nowrap;
        }

        .students-page .class-name {
            color: #344054;
            font-weight: 650;
        }

        .students-page .student-section {
            margin-top: .25rem;
            color: #8490a3;
            font-size: .78rem;
        }

        .students-page .status-pill {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            border-radius: 999px;
            padding: .4rem .7rem;
            font-size: .75rem;
            font-weight: 750;
            white-space: nowrap;
        }

        .students-page .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .students-page .status-active {
            background: #dcfce7;
            color: #166534;
        }

        .students-page .status-inactive {
            background: #fef3c7;
            color: #92400e;
        }

        .students-page .status-archived {
            background: #f1f5f9;
            color: #64748b;
        }

        .students-page .enrollment-date {
            color: #64748b;
            white-space: nowrap;
        }

        .students-page .action-button {
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            background: white;
            color: #475569;
            font-size: .8rem;
            font-weight: 650;
            padding: .45rem .7rem;
        }

            .students-page .action-button:hover,
            .students-page .action-button[aria-expanded="true"] {
                border-color: #c7d2fe;
                background: #eef2ff;
                color: #4338ca;
            }

        .students-page .dropdown-menu {
            min-width: 190px;
            padding: .45rem;
            border: 1px solid #e8edf4;
            border-radius: 12px;
            box-shadow: 0 12px 32px rgba(15, 23, 42, .12);
        }

        .students-page .dropdown-item {
            padding: .65rem .75rem;
            border-radius: 8px;
            font-size: .85rem;
        }

            .students-page .dropdown-item:hover {
                background: #f1f5f9;
            }

        .students-page .empty-state {
            padding: 4rem 1.5rem;
            text-align: center;
        }

        .students-page .empty-icon {
            width: 76px;
            height: 76px;
            margin: 0 auto 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 24px;
            background: #eef2ff;
            color: #4f46e5;
            font-size: 2rem;
        }

        .students-page .empty-title {
            font-weight: 800;
            color: #172033;
        }

        .students-page .empty-description {
            color: var(--student-muted);
            font-size: .9rem;
        }

        .students-page .alert {
            border: 0;
            border-radius: 12px;
        }

        @@media (max-width: 767.98px) {
            .students-page .stat-card {
                padding: 1.1rem;
            }

            .students-page .stat-value {
                font-size: 1.7rem;
            }

            .students-page .directory-header {
                padding: 1.15rem;
            }

            .students-page .student-table thead th:first-child,
            .students-page .student-table tbody td:first-child {
                padding-left: 1rem;
            }

            .students-page .student-table thead th:last-child,
            .students-page .student-table tbody td:last-child {
                padding-right: 1rem;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .students-page,
            .students-page * {
                animation: none !important;
                transition: none !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
}

<div class="container-fluid py-4 students-page">

    <!-- Page header -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <div class="page-eyebrow mb-2">Administration / Students</div>
            <h1 class="page-title mb-2">Student Management</h1>
            <p class="page-description mb-0">
                Manage student records, accounts, classes and enrollment.
            </p>
        </div>

        <div>
            <a asp-controller="Students"
               asp-action="Create"
               class="btn btn-add-student">
                <i class="bi bi-person-plus me-2"></i>
                Add Student
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="stat-card">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Total Students</div>
                        <div class="stat-value">@Model.TotalStudents</div>
                    </div>
                    <div class="stat-icon icon-indigo">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="stat-footnote">
                    <i class="bi bi-collection me-1"></i>
                    All registered student records
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="stat-card">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Active Students</div>
                        <div class="stat-value">@Model.ActiveStudents</div>
                    </div>
                    <div class="stat-icon icon-green">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                </div>
                <div class="stat-footnote">
                    <i class="bi bi-check-circle me-1"></i>
                    Currently active students
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="stat-card">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Inactive Students</div>
                        <div class="stat-value">@Model.InactiveStudents</div>
                    </div>
                    <div class="stat-icon icon-gray">
                        <i class="bi bi-person-dash-fill"></i>
                    </div>
                </div>
                <div class="stat-footnote">
                    <i class="bi bi-archive me-1"></i>
                    Archived or inactive records
                </div>
            </div>
        </div>

    </div>

    <!-- Search and filters -->
    <div class="section-card mb-4">
        <div class="p-4">
            <div class="d-flex align-items-center gap-2 mb-3">
                <div class="stat-icon icon-indigo" style="width: 38px; height: 38px; border-radius: 11px; font-size: 1rem;">
                    <i class="bi bi-sliders"></i>
                </div>
                <div>
                    <h2 class="filter-heading mb-0">Find Students</h2>
                    <div class="text-muted small">Search and narrow down your directory</div>
                </div>
            </div>

            <form asp-controller="Students" asp-action="Index" method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-12 col-lg-5">
                        <label for="searchTerm" class="form-label">Search students</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text"
                                   id="searchTerm"
                                   name="searchTerm"
                                   value="@Model.SearchTerm"
                                   class="form-control"
                                   placeholder="Name, admission number or email..." />
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="classId" class="form-label">Class</label>
                        <select id="classId" name="classId" class="form-select">
                            <option value="">All Classes</option>
                            @foreach (var schoolClass in Model.Classes)
                            {
                                if (Model.ClassId == schoolClass.Id)
                                {
                                    <option value="@schoolClass.Id" selected>
                                        @schoolClass.DisplayName
                                    </option>
                                }
                                else
                                {
                                    <option value="@schoolClass.Id">
                                        @schoolClass.DisplayName
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-2">
                        <label for="status" class="form-label">Status</label>
                        <select id="status" name="status" class="form-select">
                            @if (string.IsNullOrWhiteSpace(Model.Status))
                            {
                                <option value="" selected>All Statuses</option>
                            }
                            else
                            {
                                <option value="">All Statuses</option>
                            }

                            @if (Model.Status == "Active")
                            {
                                <option value="Active" selected>Active</option>
                            }
                            else
                            {
                                <option value="Active">Active</option>
                            }

                            @if (Model.Status == "Inactive")
                            {
                                <option value="Inactive" selected>Inactive</option>
                            }
                            else
                            {
                                <option value="Inactive">Inactive</option>
                            }

                            @if (Model.Status == "Archived")
                            {
                                <option value="Archived" selected>Archived</option>
                            }
                            else
                            {
                                <option value="Archived">Archived</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-lg-2">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-filter flex-grow-1">
                                <i class="bi bi-funnel me-1"></i>
                                Filter
                            </button>

                            <a asp-controller="Students"
                               asp-action="Index"
                               class="btn btn-outline-secondary btn-clear d-flex align-items-center justify-content-center"
                               title="Clear filters"
                               aria-label="Clear filters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- Student directory -->
    <div class="section-card">

        <div class="directory-header">
            <div>
                <h2 class="directory-heading mb-0">Student Directory</h2>
                <div class="directory-subtitle">
                    Manage student profiles and enrollment information
                </div>
            </div>

            <span class="directory-count">
                <i class="bi bi-people me-1"></i>
                @Model.Students.Count student(s)
            </span>
        </div>

        @if (Model.Students.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h3 class="empty-title h5">No students found</h3>

                <p class="empty-description mb-4">
                    Try changing your search or filter criteria.
                </p>

                <a asp-controller="Students"
                   asp-action="Create"
                   class="btn btn-add-student">
                    <i class="bi bi-person-plus me-2"></i>
                    Add Student
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table student-table align-middle">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Admission No.</th>
                            <th>Class</th>
                            <th>Status</th>
                            <th>Enrollment</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <!-- Student -->
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="student-avatar">
                                            @GetInitials(student.FullName)
                                        </div>

                                        <div>
                                            <div class="student-name">
                                                @student.FullName
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(student.Email))
                                            {
                                                <div class="student-email">
                                                    @student.Email
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Admission number -->
                                <td>
                                    <span class="admission-number">
                                        @student.AdmissionNumber
                                    </span>
                                </td>

                                <!-- Class -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(student.ClassName))
                                    {
                                        <div class="class-name">@student.ClassName</div>

                                        @if (!string.IsNullOrWhiteSpace(student.Section))
                                        {
                                            <div class="student-section">
                                                Section @student.Section
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not assigned</span>
                                    }
                                </td>

                                <!-- Status -->
                                <td>
                                    @if (student.IsActive &&
                                   string.Equals(student.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-pill status-active">
                                            <span class="status-dot"></span>
                                            Active
                                        </span>
                                    }
                                    else if (string.Equals(student.Status, "Archived", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-pill status-archived">
                                            <span class="status-dot"></span>
                                            Archived
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-inactive">
                                            <span class="status-dot"></span>
                                            @student.Status
                                        </span>
                                    }
                                </td>

                                <!-- Enrollment date -->
                                <td>
                                    <span class="enrollment-date">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @student.EnrollmentDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <!-- Existing actions -->
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn action-button dropdown-toggle"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false">
                                            Actions
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-controller="Students"
                                                   asp-action="Details"
                                                   asp-route-id="@student.Id">
                                                    <i class="bi bi-eye me-2 text-primary"></i>
                                                    View Details
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item"
                                                   asp-controller="Students"
                                                   asp-action="Edit"
                                                   asp-route-id="@student.Id">
                                                    <i class="bi bi-pencil me-2 text-primary"></i>
                                                    Edit Student
                                                </a>
                                            </li>

                                            @if (student.IsActive)
                                            {
                                                <li>
                                                    <hr class="dropdown-divider" />
                                                </li>

                                                <li>
                                                    <form asp-controller="Students"
                                                          asp-action="Archive"
                                                          asp-route-id="@student.Id"
                                                          method="post"
                                                          onsubmit="return confirm('Are you sure you want to archive this student?');">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="dropdown-item text-danger">
                                                            <i class="bi bi-archive me-2"></i>
                                                            Archive Student
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
