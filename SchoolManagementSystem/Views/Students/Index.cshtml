
@model SchoolManagementSystem.Application.ViewModels.Students.StudentListViewModel

@{
    ViewData["Title"] = "Students";

    string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "ST";
        }

        var parts = fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            return parts[0].Length >= 2
                ? parts[0][..2].ToUpperInvariant()
                : parts[0].ToUpperInvariant();
        }

        return $"{parts[0][0]}{parts[^1][0]}"
            .ToUpperInvariant();
    }
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex flex-column flex-lg-row
                justify-content-between
                align-items-lg-center
                gap-3 mb-4">

        <div>
            <div class="text-muted small mb-1">
                Administration
            </div>

            <h1 class="h3 fw-bold mb-1">
                Student Management
            </h1>

            <p class="text-muted mb-0">
                Manage student records, accounts, classes and enrollment.
            </p>
        </div>

        <div>
            <a asp-controller="Students"
               asp-action="Create"
               class="btn btn-primary px-4">
                <i class="bi bi-person-plus me-2"></i>
                Add Student
            </a>
        </div>
    </div>


    <!-- ========================================================= -->
    <!-- ALERTS -->
    <!-- ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- ========================================================= -->
    <!-- STATISTICS -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>
                            <div class="text-muted small mb-2">
                                Total Students
                            </div>

                            <div class="display-6 fw-bold">
                                @Model.TotalStudents
                            </div>
                        </div>

                        <div class="rounded-circle
                                    bg-primary-subtle
                                    text-primary
                                    p-3">

                            <i class="bi bi-people fs-4"></i>

                        </div>

                    </div>

                    <div class="text-muted small mt-3">
                        All registered student records
                    </div>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>
                            <div class="text-muted small mb-2">
                                Active Students
                            </div>

                            <div class="display-6 fw-bold text-success">
                                @Model.ActiveStudents
                            </div>
                        </div>

                        <div class="rounded-circle
                                    bg-success-subtle
                                    text-success
                                    p-3">

                            <i class="bi bi-person-check fs-4"></i>

                        </div>

                    </div>

                    <div class="text-muted small mt-3">
                        Currently active students
                    </div>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>
                            <div class="text-muted small mb-2">
                                Inactive Students
                            </div>

                            <div class="display-6 fw-bold text-secondary">
                                @Model.InactiveStudents
                            </div>
                        </div>

                        <div class="rounded-circle
                                    bg-secondary-subtle
                                    text-secondary
                                    p-3">

                            <i class="bi bi-person-dash fs-4"></i>

                        </div>

                    </div>

                    <div class="text-muted small mt-3">
                        Archived or inactive records
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- FILTERS -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <form asp-controller="Students"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-12 col-lg-5">

                        <label for="searchTerm"
                               class="form-label fw-semibold">
                            Search Students
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-search text-muted"></i>
                            </span>

                            <input type="text"
                                   id="searchTerm"
                                   name="searchTerm"
                                   value="@Model.SearchTerm"
                                   class="form-control"
                                   placeholder="Name, admission number or email..." />

                        </div>

                    </div>


                    <div class="col-12 col-md-6 col-lg-3">

                        <label for="classId"
                               class="form-label fw-semibold">
                            Class
                        </label>

                        <select id="classId"
                                name="classId"
                                class="form-select">

                            <option value="">
                                All Classes
                            </option>

                            @foreach (var schoolClass in Model.Classes)
                            {
                                if (Model.ClassId == schoolClass.Id)
                                {
                                    <option value="@schoolClass.Id"
                                            selected>
                                        @schoolClass.DisplayName
                                    </option>
                                }
                                else
                                {
                                    <option value="@schoolClass.Id">
                                        @schoolClass.DisplayName
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <div class="col-12 col-md-6 col-lg-2">

                        <label for="status"
                               class="form-label fw-semibold">
                            Status
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select">

                            @if (string.IsNullOrWhiteSpace(Model.Status))
                            {
                                <option value="" selected>
                                    All Statuses
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All Statuses
                                </option>
                            }

                            @if (Model.Status == "Active")
                            {
                                <option value="Active" selected>
                                    Active
                                </option>
                            }
                            else
                            {
                                <option value="Active">
                                    Active
                                </option>
                            }

                            @if (Model.Status == "Inactive")
                            {
                                <option value="Inactive" selected>
                                    Inactive
                                </option>
                            }
                            else
                            {
                                <option value="Inactive">
                                    Inactive
                                </option>
                            }

                            @if (Model.Status == "Archived")
                            {
                                <option value="Archived" selected>
                                    Archived
                                </option>
                            }
                            else
                            {
                                <option value="Archived">
                                    Archived
                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-12 col-lg-2">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">
                                <i class="bi bi-funnel me-1"></i>
                                Filter
                            </button>

                            <a asp-controller="Students"
                               asp-action="Index"
                               class="btn btn-outline-secondary"
                               title="Clear filters">

                                <i class="bi bi-arrow-counterclockwise"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- STUDENT TABLE -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0
                    p-4 pb-3">

            <div class="d-flex
                        justify-content-between
                        align-items-center">

                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Student Directory
                    </h2>

                    <div class="text-muted small">
                        @Model.Students.Count student(s) shown
                    </div>
                </div>

                <div class="text-muted">
                    <i class="bi bi-people me-1"></i>
                    Students
                </div>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Students.Count == 0)
            {
                <div class="text-center py-5 px-4">

                    <div class="rounded-circle
                                bg-light
                                d-inline-flex
                                align-items-center
                                justify-content-center
                                mb-3"
                         style="width: 72px; height: 72px;">

                        <i class="bi bi-people fs-2 text-muted"></i>

                    </div>

                    <h3 class="h5 fw-bold">
                        No students found
                    </h3>

                    <p class="text-muted mb-4">
                        Try changing your search or filter criteria.
                    </p>

                    <a asp-controller="Students"
                       asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-person-plus me-2"></i>
                        Add Student

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover
                                  align-middle
                                  mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Student
                                </th>

                                <th>
                                    Admission No.
                                </th>

                                <th>
                                    Class
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Enrollment
                                </th>

                                <th class="text-end pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var student in Model.Students)
                            {
                                <tr>

                                    <!-- STUDENT -->

                                    <td class="ps-4">

                                        <div class="d-flex
                                                    align-items-center
                                                    gap-3">

                                            <div class="rounded-circle
                                                        bg-primary-subtle
                                                        text-primary
                                                        fw-bold
                                                        d-flex
                                                        align-items-center
                                                        justify-content-center"
                                                 style="width: 44px;
                                                        height: 44px;">

                                                @GetInitials(student.FullName)

                                            </div>

                                            <div>

                                                <div class="fw-semibold">
                                                    @student.FullName
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(student.Email))
                                                {
                                                    <div class="small text-muted">
                                                        @student.Email
                                                    </div>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- ADMISSION -->

                                    <td>

                                        <span class="fw-semibold">
                                            @student.AdmissionNumber
                                        </span>

                                    </td>


                                    <!-- CLASS -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(student.ClassName))
                                        {
                                            <div class="fw-semibold">
                                                @student.ClassName
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(student.Section))
                                            {
                                                <div class="small text-muted">
                                                    @student.Section
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not assigned
                                            </span>
                                        }

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (student.IsActive &&
                                       student.Status.Equals(
                                       "Active",
                                       StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge
                                                         rounded-pill
                                                         text-bg-success">
                                                Active
                                            </span>
                                        }
                                        else if (student.Status.Equals(
                                        "Archived",
                                        StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge
                                                         rounded-pill
                                                         text-bg-secondary">
                                                Archived
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge
                                                         rounded-pill
                                                         text-bg-warning">
                                                @student.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- ENROLLMENT -->

                                    <td>

                                        <span class="text-muted">
                                            @student.EnrollmentDate.ToString("dd MMM yyyy")
                                        </span>

                                    </td>


                                    <!-- ACTIONS -->

                                    <td class="text-end pe-4">

                                        <div class="dropdown">

                                            <button class="btn btn-sm
                                                           btn-outline-secondary
                                                           dropdown-toggle"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">

                                                Actions

                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end">

                                                <li>
                                                    <a class="dropdown-item"
                                                       asp-controller="Students"
                                                       asp-action="Details"
                                                       asp-route-id="@student.Id">

                                                        <i class="bi bi-eye me-2"></i>
                                                        View Details

                                                    </a>
                                                </li>

                                                <li>
                                                    <a class="dropdown-item"
                                                       asp-controller="Students"
                                                       asp-action="Edit"
                                                       asp-route-id="@student.Id">

                                                        <i class="bi bi-pencil me-2"></i>
                                                        Edit Student

                                                    </a>
                                                </li>

                                                @if (student.IsActive)
                                                {
                                                    <li>
                                                        <hr class="dropdown-divider" />
                                                    </li>

                                                    <li>

                                                        <form asp-controller="Students"
                                                              asp-action="Archive"
                                                              asp-route-id="@student.Id"
                                                              method="post"
                                                              onsubmit="return confirm('Are you sure you want to archive this student?');">

                                                            @Html.AntiForgeryToken()

                                                            <button type="submit"
                                                                    class="dropdown-item text-danger">

                                                                <i class="bi bi-archive me-2"></i>
                                                                Archive Student

                                                            </button>

                                                        </form>

                                                    </li>
                                                }

                                            </ul>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

