@model SchoolManagementSystem.Application.ViewModels.Students.StudentCreateViewModel

@{
    ViewData["Title"] = "Add Student";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <div class="text-muted small mb-1">
                Student Management
            </div>

            <h1 class="h3 fw-bold mb-1">
                Add Student
            </h1>

            <p class="text-muted mb-0">
                Create a student record and their school login account.
            </p>
        </div>

        <div>
            <a asp-controller="Students"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Students
            </a>
        </div>
    </div>


    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>


    <form asp-controller="Students" asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div class="row g-4">

            <div class="col-12 col-xl-8">

                <!-- Personal Information -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 p-4">
                        <h2 class="h5 fw-bold mb-1">
                            Personal Information
                        </h2>

                        <p class="text-muted small mb-0">
                            Basic information about the student.
                        </p>
                    </div>

                    <div class="card-body p-4">

                        <div class="row g-3">

                            <div class="col-12 col-md-6">
                                <label asp-for="FirstName"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control"
                                       placeholder="Enter first name"
                                       autocomplete="given-name" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger small">
                                </span>
                            </div>


                            <div class="col-12 col-md-6">
                                <label asp-for="LastName"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="LastName"
                                       class="form-control"
                                       placeholder="Enter last name"
                                       autocomplete="family-name" />

                                <span asp-validation-for="LastName"
                                      class="text-danger small">
                                </span>
                            </div>


                            <div class="col-12 col-md-6">
                                <label asp-for="AdmissionNumber"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="AdmissionNumber"
                                       class="form-control"
                                       placeholder="e.g. STD-2026-001" />

                                <div class="form-text">
                                    Must be unique within the school.
                                </div>

                                <span asp-validation-for="AdmissionNumber"
                                      class="text-danger small">
                                </span>
                            </div>


                            <div class="col-12 col-md-6">
                                <label asp-for="DateOfBirth"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger small">
                                </span>
                            </div>


                            <div class="col-12 col-md-6">
                                <label asp-for="Gender"
                                       class="form-label fw-semibold">
                                </label>

                                <select asp-for="Gender"
                                        class="form-select">

                                    <option value="">
                                        Select gender
                                    </option>

                                    <option value="Male">
                                        Male
                                    </option>

                                    <option value="Female">
                                        Female
                                    </option>

                                    <option value="Other">
                                        Other
                                    </option>

                                </select>

                                <span asp-validation-for="Gender"
                                      class="text-danger small">
                                </span>
                            </div>


                            <div class="col-12 col-md-6">
                                <label asp-for="EmergencyContact"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="EmergencyContact"
                                       class="form-control"
                                       placeholder="Phone number"
                                       autocomplete="tel" />

                                <span asp-validation-for="EmergencyContact"
                                      class="text-danger small">
                                </span>
                            </div>


                            <div class="col-12">
                                <label asp-for="Address"
                                       class="form-label fw-semibold">
                                </label>

                                <textarea asp-for="Address"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Enter student's address"></textarea>

                                <span asp-validation-for="Address"
                                      class="text-danger small">
                                </span>
                            </div>

                        </div>

                    </div>
                </div>


                <!-- School Information -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 p-4">
                        <h2 class="h5 fw-bold mb-1">
                            School Information
                        </h2>

                        <p class="text-muted small mb-0">
                            Assign the student to their class.
                        </p>
                    </div>

                    <div class="card-body p-4">

                        <div class="row g-3">

                            <div class="col-12 col-md-8">

                                <label asp-for="ClassId"
                                       class="form-label fw-semibold">
                                </label>

                                <select asp-for="ClassId"
                                        class="form-select">

                                    <option value="">
                                        Select class
                                    </option>

                                    @foreach (var schoolClass in Model.Classes)
                                    {
                                        <option value="@schoolClass.Id">
                                            @schoolClass.DisplayName
                                        </option>
                                    }

                                </select>

                                <div class="form-text">
                                    You can assign or change the class later.
                                </div>

                                <span asp-validation-for="ClassId"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-12 col-md-4">

                                <label asp-for="Status"
                                       class="form-label fw-semibold">
                                </label>

                                <select asp-for="Status"
                                        class="form-select">

                                    <option value="Active">
                                        Active
                                    </option>

                                    <option value="Inactive">
                                        Inactive
                                    </option>

                                </select>

                                <span asp-validation-for="Status"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>
                </div>


                <!-- Login Account -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 p-4">
                        <h2 class="h5 fw-bold mb-1">
                            Login Account
                        </h2>

                        <p class="text-muted small mb-0">
                            These credentials will be used by the student
                            to access the student portal.
                        </p>
                    </div>

                    <div class="card-body p-4">

                        <div class="row g-3">

                            <div class="col-12">

                                <label asp-for="Email"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="student@example.com"
                                       autocomplete="email" />

                                <div class="form-text">
                                    This email address must be unique.
                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-12 col-md-6">

                                <label asp-for="Password"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Enter password"
                                       autocomplete="new-password" />

                                <div class="form-text">
                                    Minimum 8 characters with uppercase,
                                    lowercase and a number.
                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-12 col-md-6">

                                <label asp-for="ConfirmPassword"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control"
                                       placeholder="Confirm password"
                                       autocomplete="new-password" />

                                <span asp-validation-for="ConfirmPassword"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>
                </div>


                <!-- Buttons -->

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mb-4">

                    <a asp-controller="Students"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        <i class="bi bi-person-plus me-2"></i>
                        Create Student
                    </button>

                </div>

            </div>


            <!-- Right Column -->

            <div class="col-12 col-xl-4">

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-body p-4">

                        <div class="d-flex align-items-center gap-3 mb-3">

                            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                                 style="width:48px;height:48px;">

                                <i class="bi bi-info-circle fs-5"></i>

                            </div>

                            <div>
                                <h3 class="h6 fw-bold mb-1">
                                    Student Account
                                </h3>

                                <div class="small text-muted">
                                    What happens when you create a student?
                                </div>
                            </div>

                        </div>


                        <div class="small text-muted">

                            <div class="d-flex gap-2 mb-3">
                                <i class="bi bi-check-circle-fill text-success mt-1"></i>

                                <span>
                                    A student record is created in the
                                    school database.
                                </span>
                            </div>


                            <div class="d-flex gap-2 mb-3">
                                <i class="bi bi-check-circle-fill text-success mt-1"></i>

                                <span>
                                    A secure Identity login account is
                                    created.
                                </span>
                            </div>


                            <div class="d-flex gap-2 mb-3">
                                <i class="bi bi-check-circle-fill text-success mt-1"></i>

                                <span>
                                    The student receives the Student role.
                                </span>
                            </div>


                            <div class="d-flex gap-2">
                                <i class="bi bi-check-circle-fill text-success mt-1"></i>

                                <span>
                                    The student can access their portal
                                    after signing in.
                                </span>
                            </div>

                        </div>

                    </div>
                </div>


                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="d-flex align-items-center gap-3 mb-3">

                            <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center"
                                 style="width:48px;height:48px;">

                                <i class="bi bi-shield-check fs-5"></i>

                            </div>

                            <div>
                                <h3 class="h6 fw-bold mb-1">
                                    Security
                                </h3>

                                <div class="small text-muted">
                                    Account protection
                                </div>
                            </div>

                        </div>


                        <ul class="small text-muted mb-0 ps-3">

                            <li class="mb-2">
                                Passwords are securely hashed by ASP.NET
                                Core Identity.
                            </li>

                            <li class="mb-2">
                                Student accounts use unique email
                                addresses.
                            </li>

                            <li>
                                Access is controlled using Identity roles.
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

