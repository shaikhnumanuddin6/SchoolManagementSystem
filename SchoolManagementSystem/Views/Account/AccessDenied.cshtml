@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center py-5">
    <div class="card shadow-sm border-0 mx-auto p-4" style="max-width: 500px; border-radius: 16px;">
        <div class="text-danger mb-3" style="font-size: 3.5rem;">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
        <p class="text-muted mb-4">
            You do not have permission to access this resource or page.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
                <i class="bi bi-box-arrow-in-left me-1"></i> Switch Account
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house-door me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>
